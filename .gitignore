# Build artifact directory used by docs/build steps — never tracked.
storage/framework/cache/

# Persisted by `buddy update` to remember whether the project is following the
# `stable` or `canary` channel. Local preference only — the channel choice
# doesn't need to be shared across team members or CI.
.stacks-channel

# Persisted by `buddy update`: last-synced channel + commit sha for the
# up-to-date short-circuit. Local-only — like the channel, it's per-checkout.
.stacks-version

# Screenshots and scratch output from the headless-browser QA driver
# (.claude/skills/stacks-browse). Regenerated on every run; never reviewed as source.
.stacks/

# Temp directory used during a `buddy update` GitHub fetch. Cleaned up by the
# upgrade action on success but listed here to keep stray copies (e.g. from a
# kill -9'd run) out of commits.
.tmp-upgrade/
.claude/scheduled_tasks.lock
/storage/framework/frontend-dist
/.stacks
/.ts-cloud
.claude/settings.local.json

# The Stacks framework is a dependency (stacksjs/stacks + buddy setup), not app source.
/storage/framework/

# Local backups of env files (may contain secrets) — never commit
.env*.bak
.env.corrupted*

# Emails rendered to disk by the `log` mail driver (MAIL_MAILER=log), which
# writes every outgoing message here as HTML instead of sending it. Local dev
# artifacts: never source, and each password-reset copy embeds a live reset
# token, so they must not reach a commit.
#
# The driver resolves this path from its own package location, NOT the working
# directory — node_modules/@stacksjs/email/dist/drivers/../../../../../logs/mail
# — so any app borrowing this project's node_modules writes its mail here too.
# That is how a dozen loghq password resets ended up in bughq's logs/mail.
/logs/

# ts-cloud's resolved server state. Machine-written, and PINNING: with a state
# file present, resolvePersistedAttachTargetBox returns the box recorded there
# and ignores `cloud.attachTo`, so a deploy keeps shipping to the old server and
# stays GREEN while doing it. analyticshq ignores this path; loghq and status
# track zero files under it. This app was the only one committing them.
storage/cloud/
