<!-- Shared marketing footer used on every marketing page.
     One source of truth for the site-wide footer, mirroring how SiteNav is shared.
     Adds an ohdear.com-style multi-column layout with a dedicated "Compare" column
     that links the alternatives index plus one page per competitor. The styles are
     in config/crosswind.ts under pageCss(), not here: a scoped block in this file
     would be rendered into the head of whichever page the visitor entered on and
     never removed again (stx-standards rule 3). They still reuse bughq's existing
     design tokens, so the footer matches the site. -->
<footer class="footer shell">
  <div class="footer-cols">
    <div class="footer-col">
      <h4>Product</h4>
      <StxLink to="/features/capture">Automatic capture</StxLink>
      <StxLink to="/features/grouping">Fingerprint grouping</StxLink>
      <StxLink to="/features/stack-traces">Readable stack traces</StxLink>
      <StxLink to="/features/releases">Releases and environments</StxLink>
      <StxLink to="/features/alerts">Alerts and triage</StxLink>
      <StxLink to="/features/self-host">Self-hosting</StxLink>
    </div>

    <div class="footer-col">
      <h4>Use cases</h4>
      <StxLink to="/use-cases">All use cases</StxLink>
      <StxLink to="/use-cases/frontend">Frontend</StxLink>
      <StxLink to="/use-cases/backend">Backend</StxLink>
      <StxLink to="/use-cases/mobile">Mobile</StxLink>
      <StxLink to="/use-cases/on-call">On-call and SRE</StxLink>
      <StxLink to="/use-cases/agencies">Agencies</StxLink>
    </div>

    <div class="footer-col">
      <h4>Compare</h4>
      <StxLink to="/compare">All alternatives compared</StxLink>
      <StxLink to="/compare/sentry">bughq vs Sentry</StxLink>
      <StxLink to="/compare/bugsnag">bughq vs Bugsnag</StxLink>
      <StxLink to="/compare/rollbar">bughq vs Rollbar</StxLink>
      <StxLink to="/compare/raygun">bughq vs Raygun</StxLink>
      <StxLink to="/compare/honeybadger">bughq vs Honeybadger</StxLink>
      <StxLink to="/compare/airbrake">bughq vs Airbrake</StxLink>
      <StxLink to="/compare/glitchtip">bughq vs GlitchTip</StxLink>
      <StxLink to="/compare/datadog">bughq vs Datadog</StxLink>
    </div>

    <div class="footer-col">
      <h4>Resources</h4>
      <StxLink to="/docs">Docs</StxLink>
      <StxLink to="/pricing">Pricing</StxLink>
      <a href="https://github.com/stacksjs/bughq">GitHub</a>
      @if (signedIn)
        <StxLink to="/dashboard">Dashboard</StxLink>
      @else
        <StxLink to="/login">Log in</StxLink>
        <StxLink to="/register">Get started</StxLink>
      @endif
    </div>
  </div>

  <div class="footer-bottom">
    <StxLink class="brand" to="/" aria-label="bughq home">
      <span class="brand-mark">b</span>
      <span class="brand-name">bughq</span>
    </StxLink>
    <span>Open source error tracking, built on Stacks and Postgres.</span>
  </div>
</footer>

