<script server>
// Server-decided auth, the same boolean the marketing layout computes.
//
// A partial's scope does not reach across an @include, so relying on the
// layout's `signedIn` meant this condition read an undefined name and was
// always falsy: a signed-in visitor saw "Log in / Get started" here, never
// "Dashboard". loghq hit this and each of its partials owns its own copy for
// exactly this reason.
const signedIn = (() => {
  try {
    return !!(typeof requestContext !== 'undefined' && requestContext.cookie && requestContext.cookie('auth-token'))
  }
  catch {
    return false
  }
})()
</script>

<!-- Shared marketing nav, included on every marketing page via the stx include
     directive with the name SiteNav. One source of truth for the top nav, with
     two CSS-only mega-menu dropdowns (Features, Use cases). No JS: panels reveal
     on hover and on keyboard focus via :focus-within. The .mega styles live in
     the style block below (public/marketing.css is out of scope for this change)
     and reuse bughq's existing design tokens so the nav matches the whole site. -->
<nav class="nav">
  <div class="nav-inner shell">
    <StxLink class="brand" to="/" aria-label="bughq home">
      <span class="brand-mark">b</span>
      <span class="brand-name">bughq</span>
    </StxLink>

    <div class="nav-links" aria-label="Primary navigation">
      <div class="mega">
        <StxLink class="mega-trigger" to="/#features" aria-haspopup="true">Features</StxLink>
        <div class="mega-panel" role="menu" aria-label="Features">
          <StxLink role="menuitem" to="/features/capture"><span class="mega-t">Automatic capture</span><span class="mega-d">One init call captures every uncaught error with full context.</span></StxLink>
          <StxLink role="menuitem" to="/features/stack-traces"><span class="mega-t">Readable stack traces</span><span class="mega-d">Source maps turn minified frames back into your code.</span></StxLink>
          <StxLink role="menuitem" to="/features/grouping"><span class="mega-t">Fingerprint grouping</span><span class="mega-d">Identical errors fold into one issue with a live count.</span></StxLink>
          <StxLink role="menuitem" to="/features/alerts"><span class="mega-t">Alerts and triage</span><span class="mega-d">Told when an issue is new or spiking, quiet for the rest.</span></StxLink>
          <StxLink role="menuitem" to="/features/releases"><span class="mega-t">Releases and environments</span><span class="mega-d">Tag every event so a regression names its own deploy.</span></StxLink>
          <StxLink role="menuitem" to="/features/self-host"><span class="mega-t">Self-hosting</span><span class="mega-d">Open source, on your own Postgres. Data stays with you.</span></StxLink>
        </div>
      </div>

      <div class="mega">
        <StxLink class="mega-trigger" to="/use-cases" aria-haspopup="true">Use cases</StxLink>
        <div class="mega-panel" role="menu" aria-label="Use cases">
          <StxLink role="menuitem" to="/use-cases"><span class="mega-t">All use cases</span><span class="mega-d">How different teams put bughq to work in production.</span></StxLink>
          <StxLink role="menuitem" to="/use-cases/frontend"><span class="mega-t">Frontend</span><span class="mega-d">Catch browser errors with source-mapped traces.</span></StxLink>
          <StxLink role="menuitem" to="/use-cases/backend"><span class="mega-t">Backend</span><span class="mega-d">Server, edge, and job errors tied to the request.</span></StxLink>
          <StxLink role="menuitem" to="/use-cases/mobile"><span class="mega-t">Mobile</span><span class="mega-d">Native crashes grouped by build and release.</span></StxLink>
          <StxLink role="menuitem" to="/use-cases/on-call"><span class="mega-t">On-call and SRE</span><span class="mega-d">Alert on new and spiking issues, not known noise.</span></StxLink>
          <StxLink role="menuitem" to="/use-cases/agencies"><span class="mega-t">Agencies</span><span class="mega-d">Every client site as its own isolated project.</span></StxLink>
        </div>
      </div>

      <StxLink to="/pricing">Pricing</StxLink>
      <StxLink to="/docs">Docs</StxLink>
      <a href="https://github.com/stacksjs/bughq">GitHub</a>
    </div>

    @if (signedIn)
      <StxLink class="btn nav-cta primary sm" to="/dashboard">Dashboard</StxLink>
    @else
      <StxLink class="nav-login" to="/login">Log in</StxLink>
      <StxLink class="btn nav-cta primary sm" to="/register">Sign up</StxLink>
    @endif

    <details class="nav-menu">
      <summary aria-label="Open menu"><span class="burger" aria-hidden="true"></span></summary>
      <div class="nav-menu-panel">
        <span class="nav-menu-group">Features</span>
        <StxLink to="/features/capture">Automatic capture</StxLink>
        <StxLink to="/features/stack-traces">Readable stack traces</StxLink>
        <StxLink to="/features/grouping">Fingerprint grouping</StxLink>
        <StxLink to="/features/alerts">Alerts and triage</StxLink>
        <StxLink to="/features/releases">Releases and environments</StxLink>
        <StxLink to="/features/self-host">Self-hosting</StxLink>

        <span class="nav-menu-group">Use cases</span>
        <StxLink to="/use-cases">All use cases</StxLink>
        <StxLink to="/use-cases/frontend">Frontend</StxLink>
        <StxLink to="/use-cases/backend">Backend</StxLink>
        <StxLink to="/use-cases/mobile">Mobile</StxLink>
        <StxLink to="/use-cases/on-call">On-call and SRE</StxLink>
        <StxLink to="/use-cases/agencies">Agencies</StxLink>

        <span class="nav-menu-group">More</span>
        <StxLink to="/pricing">Pricing</StxLink>
        <StxLink to="/docs">Docs</StxLink>
        <a href="https://github.com/stacksjs/bughq">GitHub</a>
        @if (signedIn)
          <StxLink class="btn primary sm" to="/dashboard">Dashboard</StxLink>
        @else
          <StxLink to="/login">Log in</StxLink>
          <StxLink class="btn primary sm" to="/register">Sign up</StxLink>
        @endif
      </div>
    </details>
  </div>
</nav>

