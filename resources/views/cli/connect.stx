<script server>
import { withConnectReturn } from '../../data/connect-return'

useSeoMeta({
  title: 'Connect an app - bughq',
  // Auth-walled and single-use: nothing here is worth an index entry.
  robots: 'noindex, nofollow',
})

// The approve page for `buddy hq:connect` (routes/hq.ts). The CLI opens this
// URL with the code it was issued; a signed-in person confirms, and the CLI
// collects that project's keys on its next poll. Nothing is created by loading
// the page: only the button does that.
//
// The confirmation code is deliberately NOT rendered here. The person types
// what their own terminal shows, and the server checks it (routes/hq.ts). A
// page that displayed it could be agreed with by somebody who was sent the
// link and has no terminal at all.
const query = new URLSearchParams((typeof globalThis !== 'undefined' && globalThis.__stxServeSearch) || '')
const code = query.get('code') || ''

// Signing in comes straight back here, in this tab, where the confirmation
// code is asked for. A sign-in that ended on the dashboard read as the connect
// having worked, and the terminal was left waiting.
const signInHref = withConnectReturn('/login', code)
const registerHref = withConnectReturn('/register', code)

const token = (typeof requestContext !== 'undefined' && requestContext.cookie && requestContext.cookie('auth-token')) || ''
let user = null
if (token) {
  try {
    const { sessionUser } = await import('../../../app/Support/access')
    user = await sessionUser(token)
  }
  catch { user = null }
}

// Looked up only for a signed-in viewer. A pending code answers the app's name;
// an unknown, expired or already approved one answers nothing, and the page
// says the same thing for all three so it cannot be used to test codes.
let appName = ''
let pending = false
if (user && code) {
  try {
    const { hq } = await import('~/app/Hq/service')
    const described = await hq.describeConnect(code)
    if (described) {
      appName = described.app
      pending = true
    }
  }
  catch { pending = false }
}
</script>

<script client>
import { withConnectReturn } from '../../data/connect-return'

// The code is read from the URL rather than handed over from the server
// script, so no server value crosses into client code untyped.
const error = state('')
const loading = state(false)
const connected = state('')
const confirm = state('')

async function approve(e: Event): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const typed = confirm().trim()
  if (!typed) {
    error.set('Enter the confirmation code your terminal is showing.')
    return
  }
  const code = new URLSearchParams(useRoute().query).get('code') || ''
  loading.set(true)
  error.set('')
  try {
    const res = await fetch(`/api/cli/connect/${encodeURIComponent(code)}/approve`, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ confirm: typed }),
    })
    const data = await res.json().catch(() => ({}))
    if (res.status === 401) {
      navigate(withConnectReturn('/login', code), { replace: true, reload: true })
      return
    }
    if (!res.ok) {
      error.set(data.error || 'Could not approve the connection.')
      loading.set(false)
      return
    }
    connected.set(data.project?.name || 'your app')
  }
  catch {
    error.set('Something went wrong. Please try again.')
    loading.set(false)
  }
}
</script>

<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-md w-full">
    <div class="mb-8 text-center">
      <StxLink to="/" class="text-2xl wordmark">bughq</StxLink>
    </div>

    @if (!user)
      <div class="text-center">
        <h1 class="font-semibold text-xl tracking-tight">Sign in to connect your app</h1>
        <p class="mt-2 text-sm text-subtle">Your terminal is waiting for you to approve this connection. Sign in and you will come straight back here to enter the confirmation code it is showing.</p>
        <div class="flex flex-col gap-3 mt-6">
          <a href="{{ signInHref }}" class="block py-2.5 w-full font-semibold text-center text-sm btn-accent">Sign in</a>
          <a href="{{ registerHref }}" class="block py-2.5 w-full text-center text-sm btn ghost">Create an account</a>
        </div>
      </div>
    @endif

    @if (user && !pending)
      <div class="text-center">
        <h1 class="font-semibold text-xl tracking-tight">This link is no longer valid</h1>
        <p class="mt-2 text-sm text-subtle">A connection request lasts ten minutes and can be approved once. Run the connect command again to get a new one.</p>
      </div>
    @endif

    @if (user && pending)
      @if (connected())
        <div class="text-center" role="status">
          <h1 class="font-semibold text-xl tracking-tight">Connected</h1>
          <p class="mt-2 text-sm text-subtle">{{ connected() }} is connected to bughq. You can close this tab and return to your terminal.</p>
        </div>
      @endif
      @if (!connected())
        <div class="mb-6 text-center">
          <h1 class="font-semibold text-xl tracking-tight">Connect {{ appName }} to bughq?</h1>
          <p class="mt-2 text-sm text-subtle">This creates an app called {{ appName }} in your account, or reuses the one you already have, and sends its keys to the terminal that asked.</p>
        </div>
        @if (error())
          <div id="connect-error" role="alert" class="mb-4 py-2 err notice-box">{{ error() }}</div>
        @endif
        <form action="/api/cli/connect" method="POST" @submit="approve">
          <label for="connect-confirm" class="block mb-1.5 font-medium text-subtle text-xs">Confirmation code from your terminal</label>
          <input id="connect-confirm" name="confirm" type="text" required autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="12" placeholder="ABC-DEF" :model="confirm" class="mb-4 px-3.5 py-2.5 w-full font-mono text-center text-sm tracking-[0.2em] uppercase field" :aria-invalid="error() ? 'true' : 'false'" aria-describedby="connect-confirm-help">
          <Button type="submit" :loading="loading()" fullWidth className="btn-accent">
            {{ loading() ? 'Connecting…' : 'Approve connection' }}
          </Button>
        </form>
        <p id="connect-confirm-help" class="mt-4 text-center text-subtle text-xs">The command you ran printed this code. If you did not just run a connect command yourself, or you were sent this link, close this page.</p>
      @endif
    @endif
  </div>
</div>
