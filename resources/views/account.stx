<script server>
useSeoMeta({
  title: 'Account - bughq',
  // Auth-walled. Keeps it out of the index and, with the site.config
  // entry removed, stops a canonical being minted for a URL nobody
  // signed out can load.
  robots: 'noindex, nofollow',
})
</script>

<script client>
// The account view is entirely client-rendered: /api/me is the only source, so
// the page ships a skeleton and fills in from these signals. Nothing here
// touches the DOM - the template binds to user() and pro().
const user = state(null)
const pro = state(false)

function initial(s: string | null): string {
  return (s || '?').trim().charAt(0).toUpperCase()
}

function fmtDate(v: string | null): string {
  if (!v)
    return '--'
  const d = new Date(v)
  return Number.isNaN(d.getTime())
    ? '--'
    : d.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })
}

function logout() {
  const token = localStorage.getItem('token')
  try {
    fetch('/logout', { method: 'POST', headers: { Authorization: `Bearer ${token}` } })
  }
  catch { /* best effort: the local session is cleared either way */ }
  localStorage.removeItem('token')
  localStorage.removeItem('user')
  // Setting a cookie signal to '' emits max-age=0, which is the delete.
  useStore('session').signOut()
  window.location.assign('/login')
}

// Runs on hydration, including after a fragment swap onto this page.
const token = localStorage.getItem('token')
if (token) {
  fetch('/api/me', { headers: { Authorization: `Bearer ${token}` } })
    .then((r) => {
      if (r.status === 401) {
        localStorage.removeItem('token')
        window.location.replace('/login')
        return null
      }
      return r.json()
    })
    .then((d) => {
      if (!d || !d.user)
        return
      user.set(d.user)
      pro.set(d.pro === true)
    })
    .catch(() => { /* leave the skeleton in place */ })
}
</script>


<style>
:root {
  --bg: #fbfbfd; --panel: #ffffff; --border: rgba(15,23,42,0.09);
  --text: #0b0f19; --text-2: #4b5565; --text-3: #97a1b2; --accent: #e11d48;
  --sans: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif; --mono: 'JetBrains Mono', ui-monospace, monospace;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #090b11; --panel: #10131c; --border: rgba(148,163,184,0.12);
    --text: #f3f5f9; --text-2: #b3bccb; --text-3: #667085; --accent: #fb7185; }
}
:root[data-theme="dark"] { --bg: #090b11; --panel: #10131c; --border: rgba(148,163,184,0.12);
  --text: #f3f5f9; --text-2: #b3bccb; --text-3: #667085; --accent: #fb7185; }
:root[data-theme="light"] { --bg: #fbfbfd; --panel: #ffffff; --border: rgba(15,23,42,0.09);
  --text: #0b0f19; --text-2: #4b5565; --text-3: #97a1b2; --accent: #e11d48; }
body { background: var(--bg); color: var(--text); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
.wordmark { font-weight: 700; letter-spacing: -0.03em; }
.card { background: var(--panel); border: 1px solid var(--border); border-radius: 14px; }
.btn { border-radius: 10px; transition: transform 0.12s ease, opacity 0.15s ease, background-color 0.15s ease; font-weight: 600; }
.btn:active { transform: translateY(1px); }
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { background: color-mix(in srgb, var(--accent) 88%, #000); }
.btn-ghost { border: 1px solid var(--border); color: var(--text); }
.btn-ghost:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.badge { border: 1px solid var(--border); border-radius: 999px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-2); }
.badge-pro { border-color: var(--accent); color: var(--accent); }
.avatar { border-radius: 999px; object-fit: cover; background: color-mix(in srgb, var(--accent) 14%, var(--panel)); }
.row { border-top: 1px solid var(--border); }
.skeleton { background: color-mix(in srgb, var(--text-3) 20%, transparent); border-radius: 6px; animation: pulse 1.4s ease-in-out infinite; }
@keyframes pulse { 0%,100% { opacity: 0.5; } 50% { opacity: 0.9; } }
@media (prefers-reduced-motion: reduce) { .skeleton { animation: none; } }
</style>

<div class="min-h-[100dvh]">
  <header class="max-w-3xl mx-auto flex items-center justify-between px-5 md:px-6 h-16">
    <a href="/" class="wordmark text-lg" data-no-router>bughq</a>
    <div class="flex items-center gap-2.5">
      <StxLink to="/dashboard" class="btn btn-ghost px-3.5 py-2 text-sm">Dashboard</StxLink>
      <button @click="logout" class="btn btn-ghost px-3.5 py-2 text-sm">Log out</button>
    </div>
  </header>

  <!-- A <div>, not <main>: layouts/default.stx already wraps every page fragment
       in the <main> the SPA router swaps. Nesting a second one gave the router
       two candidate containers and broke the fragment swap. -->
  <div class="max-w-3xl mx-auto px-5 md:px-6 py-8">
    <h1 class="wordmark text-2xl mb-6">Account</h1>

    <section class="card p-6 mb-5">
      <div class="flex items-center gap-4">
        @if (user() && user().avatar)
          <img class="avatar w-14 h-14" :src="user().avatar" alt="" width="56" height="56">
        @endif
        @if (!user() || !user().avatar)
          <div class="avatar w-14 h-14 grid place-items-center text-accent" style="font-weight: 700; font-size: 1.25rem">{{ user() ? initial(user().name || user().email) : '' }}</div>
        @endif
        <div class="min-w-0">
          @if (!user())
            <div class="skeleton" style="width: 160px; height: 20px"></div>
          @endif
          @if (user())
            <div class="text-lg font-semibold">{{ user().name || 'Your account' }}</div>
          @endif
          <div class="text-sm mt-1.5 text-muted">{{ user() ? (user().email || '') : '' }}</div>
        </div>
        @if (user() && user().provider)
          <span class="badge px-2.5 py-1 ml-auto">{{ user().provider }}</span>
        @endif
      </div>
    </section>

    <section class="card mb-5">
      <div class="flex items-center justify-between px-6 py-4">
        <div>
          <div class="text-xs uppercase tracking-wide text-subtle" style="font-family: var(--mono)">Plan</div>
          <div class="text-base font-semibold mt-1">
            {{ pro() ? 'Pro' : 'Free' }}
            @if (pro())
              <span class="badge badge-pro px-2 py-0.5 ml-1">active</span>
            @endif
          </div>
        </div>
        @if (pro())
          <StxLink to="/pricing" class="btn btn-ghost px-4 py-2 text-sm">Manage plan</StxLink>
        @endif
        @if (!pro())
          <StxLink to="/pricing" class="btn btn-primary px-4 py-2 text-sm">Upgrade to Pro</StxLink>
        @endif
      </div>
      <div class="row flex items-center justify-between px-6 py-4">
        <div>
          <div class="text-xs uppercase tracking-wide text-subtle" style="font-family: var(--mono)">Member since</div>
          <div class="text-base mt-1 text-muted">{{ user() ? fmtDate(user().created_at) : '--' }}</div>
        </div>
        <StxLink to="/dashboard" class="btn btn-ghost px-4 py-2 text-sm">Open dashboard</StxLink>
      </div>
    </section>

    <p class="text-sm text-subtle">
      Signed in with a private token. <a href="/" class="text-accent" data-no-router>Back to site</a>
    </p>
  </div>
</div>

<!-- Guard only: bounce to /login before paint if there is no token. Everything
     the account view renders is driven by the signals in the client script
     block at the top of this file. -->
<script>
(function () {
  if (!localStorage.getItem('token'))
    window.location.replace('/login')
})()
</script>
