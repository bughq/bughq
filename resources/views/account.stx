<script server>
useSeoMeta({
  title: 'Account - bughq',
  // Auth-walled. Keeps it out of the index and, with the site.config
  // entry removed, stops a canonical being minted for a URL nobody
  // signed out can load.
  robots: 'noindex, nofollow',
})
</script>

<script client>
// The account view is entirely client-rendered: /api/me is the only source, so
// the page ships a skeleton and fills in from these signals. Nothing here
// touches the DOM - the template binds to user() and pro().

/**
 * The signed-in user as /api/me sends it (app/Actions/MeAction.ts). The profile
 * columns are read best-effort there and default to null, so nothing but the id
 * is guaranteed to carry a value.
 */
interface AccountUser {
  id: number | string
  name: string | null
  email: string | null
  avatar: string | null
  provider: string | null
  created_at: string | null
}

/** What /api/me answers with. Everything optional: a 401 sends neither field. */
interface MeResponse {
  user?: AccountUser
  pro?: boolean
}

// Annotated rather than inferred: `state(null)` is a signal of exactly null, and
// the template binds every field off it.
const user = state<AccountUser | null>(null)
const pro = state(false)

// Both take the nullable fields straight off AccountUser, and undefined as well
// so the template can reach them through `user()?.` before /api/me has answered.
function initial(s: string | null | undefined): string {
  return (s || '?').trim().charAt(0).toUpperCase()
}

function fmtDate(v: string | null | undefined): string {
  if (!v)
    return '--'
  const d = new Date(v)
  return Number.isNaN(d.getTime())
    ? '--'
    : d.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })
}

function logout() {
  const token = useStore('session').token()
  try {
    fetch('/logout', { method: 'POST', headers: { Authorization: `Bearer ${token}` } })
  }
  catch { /* best effort: the local session is cleared either way */ }
  localStorage.removeItem('user')
  // Setting a cookie signal to '' emits max-age=0, which is the delete.
  useStore('session').signOut()
  window.location.assign('/login')
}

// Runs on hydration, including after a fragment swap onto this page.
const token = useStore('session').token()
if (token) {
  fetch('/api/me', { headers: { Authorization: `Bearer ${token}` } })
    .then((r) => {
      if (r.status === 401) {
        window.location.replace('/login')
        return null
      }
      return r.json()
    })
    .then((d: MeResponse | null) => {
      if (!d || !d.user)
        return
      user.set(d.user)
      pro.set(d.pro === true)
    })
    .catch(() => { /* leave the skeleton in place */ })
}
</script>


<style>
.card { background: var(--panel); border: 1px solid var(--border); border-radius: 14px; }
.btn { border-radius: 10px; transition: transform 0.12s ease, opacity 0.15s ease, background-color 0.15s ease; font-weight: 600; }
.btn:active { transform: translateY(1px); }
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { background: color-mix(in srgb, var(--accent) 88%, #000); }
.btn-ghost { border: 1px solid var(--border); color: var(--text); }
.btn-ghost:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.badge { border: 1px solid var(--border); border-radius: 999px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-2); }
.badge-pro { border-color: var(--accent); color: var(--accent); }
.avatar { border-radius: 999px; object-fit: cover; background: color-mix(in srgb, var(--accent) 14%, var(--panel)); }
.row { border-top: 1px solid var(--border); }
.skeleton { background: color-mix(in srgb, var(--text-3) 20%, transparent); border-radius: 6px; animation: pulse 1.4s ease-in-out infinite; }
@keyframes pulse { 0%,100% { opacity: 0.5; } 50% { opacity: 0.9; } }
@media (prefers-reduced-motion: reduce) { .skeleton { animation: none; } }
</style>

<div class="min-h-[100dvh]">
  <header class="flex items-center justify-between mx-auto px-5 md:px-6 h-16 max-w-3xl">
    <a href="/" class="text-lg wordmark">bughq</a>
    <div class="flex gap-2.5 items-center">
      <StxLink to="/dashboard" class="px-3.5 py-2 text-sm btn btn-ghost">Dashboard</StxLink>
      <button @click="logout" class="px-3.5 py-2 text-sm btn btn-ghost">Log out</button>
    </div>
  </header>

  <!-- A div, not a main element: layouts/default.stx already wraps every page
       fragment in the one main element the SPA router swaps. Nesting a second
       gave the router two candidate containers and broke the fragment swap.

       Written in prose rather than as a tag because the server's fragment
       extractor counts those tags as plain strings and does not skip comments;
       naming it literally unbalanced the count, so this page was served as a
       full document and the router injected its head into the live page. -->
  <div class="mx-auto px-5 py-8 md:px-6 max-w-3xl">
    <h1 class="mb-6 text-2xl wordmark">Account</h1>

    <section class="mb-5 p-6 card">
      <div class="flex gap-4 items-center">
        @if (user() && user().avatar)
          <img class="h-14 w-14 avatar" :src="user()?.avatar" alt="" width="56" height="56">
        @endif
        @if (!user() || !user().avatar)
          <div class="grid place-items-center h-14 w-14 text-accent avatar" style="font-weight: 700; font-size: 1.25rem">{{ user() ? initial(user()?.name || user()?.email) : '' }}</div>
        @endif
        <div class="min-w-0">
          @if (!user())
            <div class="skeleton" style="width: 160px; height: 20px"></div>
          @endif
          @if (user())
            <div class="font-semibold text-lg">{{ user()?.name || 'Your account' }}</div>
          @endif
          <div class="mt-1.5 text-muted text-sm">{{ user()?.email || '' }}</div>
        </div>
        @if (user() && user().provider)
          <span class="ml-auto px-2.5 py-1 badge">{{ user()?.provider }}</span>
        @endif
      </div>
    </section>

    <section class="mb-5 card">
      <div class="flex items-center justify-between px-6 py-4">
        <div>
          <div class="text-subtle text-xs tracking-wide uppercase" style="font-family: var(--mono)">Plan</div>
          <div class="mt-1 font-semibold text-base">
            {{ pro() ? 'Pro' : 'Free' }}
            @if (pro())
              <span class="ml-1 px-2 py-0.5 badge badge-pro">active</span>
            @endif
          </div>
        </div>
        @if (pro())
          <StxLink to="/pricing" class="px-4 py-2 text-sm btn btn-ghost">Manage plan</StxLink>
        @endif
        @if (!pro())
          <StxLink to="/pricing" class="px-4 py-2 text-sm btn btn-primary">Upgrade to Pro</StxLink>
        @endif
      </div>
      <div class="flex items-center justify-between px-6 py-4 row">
        <div>
          <div class="text-subtle text-xs tracking-wide uppercase" style="font-family: var(--mono)">Member since</div>
          <div class="mt-1 text-base text-muted">{{ fmtDate(user()?.created_at) }}</div>
        </div>
        <StxLink to="/dashboard" class="px-4 py-2 text-sm btn btn-ghost">Open dashboard</StxLink>
      </div>
    </section>

    <p class="text-sm text-subtle">
      Signed in with a private token. <a href="/" class="text-accent">Back to site</a>
    </p>
  </div>
</div>

<!-- Guard only: bounce to /login before paint if there is no token. Everything
     the account view renders is driven by the signals in the client script
     block at the top of this file. -->
<script>
(function () {
  if (!useStore('session').signedIn())
    window.location.replace('/login')
})()
</script>
