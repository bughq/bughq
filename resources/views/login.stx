<script server>
// Show a provider's sign-in button only when it's actually configured, so the
// buttons stay hidden until credentials are set (then reappear automatically —
// no code change). See config/services.ts.
const services = (await import('../../config/services')).default
const githubEnabled = !!services.github?.clientId
const googleEnabled = !!services.google?.clientId
const anyOauth = githubEnabled || googleEnabled

// The OAuth failure message arrives as `?error=…` on the redirect back from the
// provider. Read server-side rather than in a bare <script> that hunted for
// #oauth-error and toggled style.display: the banner is then part of the first
// paint instead of appearing a frame later, and there is no hidden element in
// the markup waiting to be found.
//
// requestContext.url() is the whole URL, so the query comes off a real URL
// parser. Guarded the same way as issue/[id].stx — the context is not
// guaranteed to be present on every render path.
let oauthError = ''
try {
  const u = (typeof requestContext !== 'undefined' && requestContext.url && requestContext.url()) || ''
  if (u)
    oauthError = new URL(u).searchParams.get('error') || ''
}
catch {
  oauthError = ''
}

useHead({ title: 'Sign in - bughq' })
</script>

<script client>
// Token auth via stx client directives. Uncontrolled inputs read from the submit
// event; error/loading are signals.
const error = state('')
const loading = state(false)

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target
  loading.set(true)
  error.set('')
  try {
    const res = await fetch('/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: form.elements.email.value, password: form.elements.password.value }),
    })
    const data = await res.json().catch(() => ({}))
    if (!res.ok) {
      error.set(data.message || 'Invalid email or password.')
      return
    }
    const token = data.token || data.access_token || ''
    // The cookie is what server-rendered pages authenticate from. The store owns
    // its serialisation — path, max-age, samesite and the https-only `secure`.
    useStore('session').token.set(token)
    if (data.user)
      localStorage.setItem('user', JSON.stringify(data.user))
    navigate('/dashboard')
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>


<style>
.field:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent); }
.err { background: color-mix(in srgb, #ef4444 12%, transparent); color: #ef4444; }
.divider { display: flex; align-items: center; gap: 0.75rem; color: var(--text-3); font-size: 12px; }
.divider::before, .divider::after { content: ""; height: 1px; flex: 1; background: var(--border); }
</style>

<div class="min-h-[100dvh] flex items-center justify-center px-5 py-12">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <a href="/" class="wordmark text-2xl" data-no-router>bughq</a>
      <p class="text-sm mt-2 text-subtle">Sign in to your account</p>
    </div>

    <form @submit="handleSubmit" class="space-y-4">
      @if (error())
        <div class="err text-sm rounded-lg px-3 py-2">{{ error() }}</div>
      @endif

      <div>
        <label class="block text-xs font-medium mb-1.5 text-muted">Email</label>
        <input name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="field w-full px-3.5 py-2.5 text-sm">
      </div>
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-xs font-medium text-muted">Password</label>
          <StxLink to="/forgot-password" class="text-xs font-medium text-accent">Forgot password?</StxLink>
        </div>
        <input name="password" type="password" required autocomplete="current-password" placeholder="••••••••" class="field w-full px-3.5 py-2.5 text-sm">
      </div>

      <button type="submit" :disabled="loading()" class="btn-accent w-full py-2.5 text-sm font-semibold">
        {{ loading() ? 'Signing in…' : 'Sign in' }}
      </button>
    </form>

    @if (oauthError)
    <div class="err text-sm rounded-lg px-3 py-2 mt-4">{{ oauthError }}</div>
    @endif

    @if (anyOauth)
    <div class="divider my-5">or</div>

    <div class="space-y-2.5">
      @if (githubEnabled)
      <a href="/api/auth/github/redirect" data-no-router class="oauth-btn flex items-center justify-center gap-2 w-full py-2.5 text-sm font-medium">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-1.8c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 5 18.3 5.3 18.3 5.3c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
        Continue with GitHub
      </a>
      @endif
      @if (googleEnabled)
      <a href="/api/auth/google/redirect" data-no-router class="oauth-btn flex items-center justify-center gap-2 w-full py-2.5 text-sm font-medium">
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6Z"/><path fill="#34A853" d="M12 23c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3C3.7 20.5 7.6 23 12 23Z"/><path fill="#FBBC05" d="M5.6 13.7a6.6 6.6 0 0 1 0-4.3v-3H1.8a11 11 0 0 0 0 10.3l3.8-3Z"/><path fill="#EA4335" d="M12 5.4c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.9 15.1 1 12 1 7.6 1 3.7 3.5 1.8 7.4l3.8 3c.9-2.7 3.4-5 6.4-5Z"/></svg>
        Continue with Google
      </a>
      @endif
    </div>
    @endif

    <p class="text-center text-sm mt-6 text-subtle">
      No account?
      <StxLink to="/register" class="font-medium text-accent">Create one</StxLink>
    </p>
  </div>
</div>
