<script server>
// Show a provider's sign-in button only when it's actually configured, so the
// buttons stay hidden until credentials are set (then reappear automatically —
// no code change). See config/services.ts.
const services = (await import('../../config/services')).default
const githubEnabled = !!services.github?.clientId
const googleEnabled = !!services.google?.clientId
const anyOauth = githubEnabled || googleEnabled
</script>

<script client>
// Token auth via stx client directives. Uncontrolled inputs read from the submit
// event; error/loading are signals.
const error = state('')
const loading = state(false)

async function handleSubmit(e) {
  e.preventDefault()
  if (loading())
    return
  const form = e.target
  loading.set(true)
  error.set('')
  try {
    const res = await fetch('/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: form.elements.email.value, password: form.elements.password.value }),
    })
    const data = await res.json().catch(() => ({}))
    if (!res.ok) {
      error.set(data.message || 'Invalid email or password.')
      return
    }
    const token = data.token || data.access_token || ''
    localStorage.setItem('token', token)
    // Mirror the token into a cookie so server-rendered pages can authenticate.
    document.cookie = `bughq_token=${token}; path=/; max-age=2592000; samesite=lax${location.protocol === 'https:' ? '; secure' : ''}`
    if (data.user)
      localStorage.setItem('user', JSON.stringify(data.user))
    navigate('/dashboard')
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">

<style>
:root {
  --bg: #fbfbfd; --panel: #ffffff; --border: rgba(15,23,42,0.09);
  --text: #0b0f19; --text-2: #4b5565; --text-3: #97a1b2; --accent: #e11d48;
  --sans: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif; --mono: 'JetBrains Mono', ui-monospace, monospace;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #090b11; --panel: #10131c; --border: rgba(148,163,184,0.12);
    --text: #f3f5f9; --text-2: #b3bccb; --text-3: #667085; --accent: #fb7185; }
}
:root[data-theme="dark"] { --bg: #090b11; --panel: #10131c; --border: rgba(148,163,184,0.12);
  --text: #f3f5f9; --text-2: #b3bccb; --text-3: #667085; --accent: #fb7185; }
:root[data-theme="light"] { --bg: #fbfbfd; --panel: #ffffff; --border: rgba(15,23,42,0.09);
  --text: #0b0f19; --text-2: #4b5565; --text-3: #97a1b2; --accent: #e11d48; }
body { background: var(--bg); color: var(--text); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
.wordmark { font-weight: 700; letter-spacing: -0.03em; }
.field { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; color: var(--text); }
.field:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent); }
.btn { background: var(--accent); color: #fff; border-radius: 10px; transition: transform 0.12s ease, opacity 0.15s ease; }
.btn:hover { background: color-mix(in srgb, var(--accent) 88%, #000); }
.btn:active { transform: translateY(1px); }
.btn:disabled { opacity: 0.6; cursor: default; }
.err { background: color-mix(in srgb, #ef4444 12%, transparent); color: #ef4444; }
.oauth-btn { border: 1px solid var(--border); border-radius: 10px; color: var(--text); background: var(--panel); transition: border-color 0.15s ease, transform 0.12s ease; }
.oauth-btn:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.oauth-btn:active { transform: translateY(1px); }
.divider { display: flex; align-items: center; gap: 0.75rem; color: var(--text-3); font-size: 12px; }
.divider::before, .divider::after { content: ""; height: 1px; flex: 1; background: var(--border); }
</style>

<!-- Applies the saved theme on load. Keep this inline in every app page.

     data-theme lives on the root html element, which the SPA router never
     swaps, so a page reached by a fragment swap inherits it for free. A page
     loaded DIRECTLY only gets it here — so the seven pages that lacked
     it rendered the saved theme when navigated to and the OS default when
     hard-loaded: one URL, two renders depending on how you arrived.

     Not extracted into an @include partial: stx rewrites any page script
     into a scoped client script either way (verified — this is pre-existing
     behaviour, not something the inline form avoids), and the include buys
     no isolation while rendering to nothing in the SSG build path.

     No signal or store either: the theme already lives in two places that
     outlive a swap (the html attribute and localStorage); a store would add
     a third copy of the same fact and fix nothing.

     A missing key means "follow the OS", which the prefers-color-scheme CSS
     already handles, so only an explicit light/dark is applied. try/catch
     because localStorage throws in Safari private mode. -->
<script>(function(){try{var t=localStorage.getItem('bughq_theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t)}catch(e){}})()</script>

<div class="min-h-[100dvh] flex items-center justify-center px-5 py-12">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <a href="/" data-no-router class="wordmark text-2xl">bughq</a>
      <p class="text-sm mt-2 text-subtle">Sign in to your account</p>
    </div>

    <form @submit="handleSubmit" class="space-y-4">
      @if (error())
        <div class="err text-sm rounded-lg px-3 py-2">{{ error() }}</div>
      @endif

      <div>
        <label class="block text-xs font-medium mb-1.5 text-muted">Email</label>
        <input name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="field w-full px-3.5 py-2.5 text-sm">
      </div>
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-xs font-medium text-muted">Password</label>
          <StxLink to="/forgot-password" class="text-xs font-medium text-accent">Forgot password?</StxLink>
        </div>
        <input name="password" type="password" required autocomplete="current-password" placeholder="••••••••" class="field w-full px-3.5 py-2.5 text-sm">
      </div>

      <button type="submit" :disabled="loading()" class="btn w-full py-2.5 text-sm font-semibold">
        {{ loading() ? 'Signing in…' : 'Sign in' }}
      </button>
    </form>

    <div id="oauth-error" class="err text-sm rounded-lg px-3 py-2 mt-4" style="display:none"></div>

    @if (anyOauth)
    <div class="divider my-5">or</div>

    <div class="space-y-2.5">
      @if (githubEnabled)
      <a href="/api/auth/github/redirect" class="oauth-btn flex items-center justify-center gap-2 w-full py-2.5 text-sm font-medium">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-1.8c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 5 18.3 5.3 18.3 5.3c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
        Continue with GitHub
      </a>
      @endif
      @if (googleEnabled)
      <a href="/api/auth/google/redirect" class="oauth-btn flex items-center justify-center gap-2 w-full py-2.5 text-sm font-medium">
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6Z"/><path fill="#34A853" d="M12 23c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3C3.7 20.5 7.6 23 12 23Z"/><path fill="#FBBC05" d="M5.6 13.7a6.6 6.6 0 0 1 0-4.3v-3H1.8a11 11 0 0 0 0 10.3l3.8-3Z"/><path fill="#EA4335" d="M12 5.4c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.9 15.1 1 12 1 7.6 1 3.7 3.5 1.8 7.4l3.8 3c.9-2.7 3.4-5 6.4-5Z"/></svg>
        Continue with Google
      </a>
      @endif
    </div>
    @endif

    <p class="text-center text-sm mt-6 text-subtle">
      No account?
      <StxLink to="/register" class="font-medium text-accent">Create one</StxLink>
    </p>
  </div>
</div>

<script>
(function () {
  try {
    var msg = new URLSearchParams(window.location.search).get('error')
    if (!msg) return
    var el = document.getElementById('oauth-error')
    if (el) { el.textContent = msg; el.style.display = 'block' }
  } catch (e) {}
})()
</script>