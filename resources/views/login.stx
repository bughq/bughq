<script server>
// Show a provider's sign-in button only when it's actually configured, so the
// buttons stay hidden until credentials are set (then reappear automatically —
// no code change). See config/services.ts.
const services = (await import('../../config/services')).default
const githubEnabled = !!services.github?.clientId
const googleEnabled = !!services.google?.clientId
const anyOauth = githubEnabled || googleEnabled

// The OAuth failure message arrives as `?error=…` on the redirect back from the
// provider. Read server-side rather than in a bare <script> that hunted for
// #oauth-error and toggled style.display: the banner is then part of the first
// paint instead of appearing a frame later, and there is no hidden element in
// the markup waiting to be found.
//
// requestContext.url() is the whole URL, so the query comes off a real URL
// parser. Guarded because the context is absent on some render paths (SSG, the
// client bundle) — not because its shape is in doubt: types/domain.d.ts now
// mirrors @stacksjs/config's own declaration.
let oauthError = ''
try {
  const u = typeof requestContext !== 'undefined' && requestContext.url ? requestContext.url() : ''
  if (u)
    oauthError = new URL(u).searchParams.get('error') || ''
}
catch {
  oauthError = ''
}

useHead({ title: 'Sign in - bughq' })
</script>

<script client>
// Cookie auth via stx client directives. On success the server sets an HttpOnly
// `auth-token` cookie (Set-Cookie) — this page stores nothing; it just POSTs
// same-origin and navigates. Uncontrolled inputs read from the submit event;
// error/loading/step are signals.
const error = state('')
const loading = state(false)
// Two-step flow: 'credentials' -> (on a 2FA-enabled account) 'twofa'.
const step = state('credentials')
// The challenge minted by LoginAction when the account has 2FA on; exchanged
// with the TOTP code at /verify-two-factor-login.
const challengeToken = state('')
// The "remember me" choice captured at step 1, re-sent with the 2FA code so a
// 2FA account is issued the same session tier (7d vs 30d), not silently
// downgraded to the baseline week.
const rememberChoice = state(false)

/** What POST /login and /verify-two-factor-login answer with. */
interface LoginResponse {
  message?: string
  token?: string
  access_token?: string
  requires_two_factor?: boolean
  challenge_token?: string
  user?: unknown
}

// Reading an uncontrolled field is two narrowings: `e.target` is an EventTarget
// and `form.elements` hands back Elements, and neither of those carries a
// `.value`. A field the markup does not contain reads as empty rather than
// throwing — the endpoint validates what it is sent regardless.
function fieldValue(form: HTMLFormElement, name: string): string {
  const el = form.elements.namedItem(name)
  return el instanceof HTMLInputElement ? el.value : ''
}

/** A checkbox reads by `.checked`, not `.value` (which is the constant 'on'). */
function fieldChecked(form: HTMLFormElement, name: string): boolean {
  const el = form.elements.namedItem(name)
  return el instanceof HTMLInputElement ? el.checked : false
}

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target
  if (!(form instanceof HTMLFormElement))
    return
  loading.set(true)
  error.set('')
  const remember = fieldChecked(form, 'remember')
  rememberChoice.set(remember)
  try {
    const res = await fetch('/login', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: fieldValue(form, 'email'), password: fieldValue(form, 'password'), remember }),
    })
    const data: LoginResponse = await res.json().catch(() => ({}))
    // A 2FA-enabled account: no session yet, just a challenge. Switch to the
    // TOTP step and wait for the code.
    if (data.requires_two_factor && data.challenge_token) {
      challengeToken.set(data.challenge_token)
      step.set('twofa')
      return
    }
    if (!res.ok) {
      error.set(data.message || 'Invalid email or password.')
      return
    }
    // Session is established by the HttpOnly cookie the server set; nothing to
    // store here.
    navigate('/dashboard')
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}

async function handleTwoFactor(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target
  if (!(form instanceof HTMLFormElement))
    return
  loading.set(true)
  error.set('')
  try {
    const res = await fetch('/verify-two-factor-login', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ challenge_token: challengeToken(), code: fieldValue(form, 'code'), remember: rememberChoice() }),
    })
    const data: LoginResponse = await res.json().catch(() => ({}))
    if (!res.ok) {
      // Challenge tokens are single-use; a failed code sends the user back to
      // step 1 to start over rather than retrying a spent challenge.
      error.set(data.message || 'Invalid code — please sign in again.')
      step.set('credentials')
      challengeToken.set('')
      return
    }
    navigate('/dashboard')
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>


<style>
.field:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent); }
.err { background: color-mix(in srgb, #ef4444 12%, transparent); color: #ef4444; }
.divider { display: flex; align-items: center; gap: 0.75rem; color: var(--text-3); font-size: 12px; }
.divider::before, .divider::after { content: ""; height: 1px; flex: 1; background: var(--border); }
</style>

<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-sm w-full">
    <div class="mb-8 text-center">
      <a href="/" class="text-2xl wordmark">bughq</a>
      <p class="mt-2 text-sm text-subtle">Sign in to your account</p>
    </div>

    @if (error())
      <div class="mb-4 px-3 py-2 text-sm rounded-lg err">{{ error() }}</div>
    @endif

    @if (step() === 'credentials')
    <form @submit="handleSubmit" class="space-y-4">
      <div>
        <label for="login-email" class="block mb-1.5 font-medium text-muted text-xs">Email</label>
        <input name="email" id="login-email" type="email" required autocomplete="email" placeholder="you@example.com" class="px-3.5 py-2.5 w-full text-sm field">
      </div>
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="login-password" class="block font-medium text-muted text-xs">Password</label>
          <StxLink to="/forgot-password" class="font-medium text-accent text-xs">Forgot password?</StxLink>
        </div>
        <input name="password" id="login-password" type="password" required autocomplete="current-password" placeholder="••••••••" class="px-3.5 py-2.5 w-full text-sm field">
      </div>

      <label for="login-remember" class="flex gap-2 items-center text-sm cursor-pointer select-none text-subtle">
        <input name="remember" id="login-remember" type="checkbox" class="w-4 h-4 accent-[var(--accent)] cursor-pointer">
        <span>Keep me signed in for 30 days</span>
      </label>

      <button type="submit" :disabled="loading()" class="py-2.5 w-full font-semibold text-sm btn-accent">
        {{ loading() ? 'Signing in…' : 'Sign in' }}
      </button>
    </form>
    @endif

    @if (step() === 'twofa')
    <form @submit="handleTwoFactor" class="space-y-4">
      <p class="text-sm text-subtle">Enter the 6-digit code from your authenticator app.</p>
      <div>
        <label for="login-code" class="block mb-1.5 font-medium text-muted text-xs">Authentication code</label>
        <input name="code" id="login-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required placeholder="123456" class="px-3.5 py-2.5 w-full text-sm field">
      </div>
      <button type="submit" :disabled="loading()" class="py-2.5 w-full font-semibold text-sm btn-accent">
        {{ loading() ? 'Verifying…' : 'Verify & sign in' }}
      </button>
    </form>
    @endif

    @if (oauthError)
    <div class="mt-4 px-3 py-2 text-sm rounded-lg err">{{ oauthError }}</div>
    @endif

    @if (anyOauth && step() === 'credentials')
    <div class="my-5 divider">or</div>

    <div class="space-y-2.5">
      @if (githubEnabled)
      <a href="/api/auth/github/redirect" data-no-router class="flex gap-2 items-center justify-center py-2.5 w-full font-medium text-sm oauth-btn">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-1.8c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 5 18.3 5.3 18.3 5.3c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
        Continue with GitHub
      </a>
      @endif
      @if (googleEnabled)
      <a href="/api/auth/google/redirect" data-no-router class="flex gap-2 items-center justify-center py-2.5 w-full font-medium text-sm oauth-btn">
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6Z"/><path fill="#34A853" d="M12 23c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3C3.7 20.5 7.6 23 12 23Z"/><path fill="#FBBC05" d="M5.6 13.7a6.6 6.6 0 0 1 0-4.3v-3H1.8a11 11 0 0 0 0 10.3l3.8-3Z"/><path fill="#EA4335" d="M12 5.4c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.9 15.1 1 12 1 7.6 1 3.7 3.5 1.8 7.4l3.8 3c.9-2.7 3.4-5 6.4-5Z"/></svg>
        Continue with Google
      </a>
      @endif
    </div>
    @endif

    <p class="mt-6 text-center text-sm text-subtle">
      No account?
      <StxLink to="/register" class="font-medium text-accent">Create one</StxLink>
    </p>
  </div>
</div>
