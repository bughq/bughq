<script server>
// Per-project settings (owner-only admin surface): the API key, team members,
// Slack/Discord alerts, and deletion. Authenticates from the bughq_token cookie
// and resolves the active project from the bughq_project cookie (same browsing
// preference the dashboard uses), scoped to projects the user OWNS — members can
// view/triage issues but only an owner administers a project. Reads happen here
// server-side; mutations go client-side to the owner-scoped /api endpoints.
useSeoMeta({
  title: 'Settings - bughq',
  // Auth-walled. Keeps it out of the index and, with the site.config
  // entry removed, stops a canonical being minted for a URL nobody
  // signed out can load.
  robots: 'noindex, nofollow',
})

const { db } = await import('@stacksjs/database')
const { appUrl, ingestUrl } = await import('../../app/Support/urls')
// APP_BASE is the web app (join links); INGEST_BASE is where /sdk.js + /errors
// are served (a separate host in local dev). Both are absolute and env-driven,
// falling back to the local servers. See app/Support/urls.ts.
const APP_BASE = appUrl()
const INGEST_BASE = ingestUrl()

const query = new URLSearchParams((typeof globalThis !== 'undefined' && globalThis.__stxServeSearch) || '')
const requestedProject = query.get('project')
// Set by the reload that follows a successful rotation. The reload is what
// keeps the key field, the masked view and both copies in the install snippet
// telling the same story; this flag is only how the confirmation and the
// revealed key survive it.
const justRotated = query.get('rotated') === '1'
const cookieProject = (typeof requestContext !== 'undefined' && requestContext.cookie && requestContext.cookie('bughq_project')) || ''

const token = (typeof requestContext !== 'undefined' && requestContext.cookie && requestContext.cookie('bughq_token')) || ''
let user = null
if (token) {
  try {
    const { Auth } = await import('@stacksjs/auth')
    user = await Auth.getUserFromToken(token)
  }
  catch { user = null }
}

let projects = []
let activeProject = null
let needsOnboarding = false
let channels = []
let members = []
let invites = []
if (user) {
  // Owned projects only — settings is the owner's admin surface.
  projects = (await db.unsafe(
    'SELECT id, name, platform, ingest_key, is_active FROM projects WHERE owner_id = $1 ORDER BY created_at DESC NULLS LAST, id',
    [Number(user.id)],
  )) ?? []
  if (projects.length === 0)
    needsOnboarding = true
  else
    activeProject = projects.find(p => p.id === requestedProject) || projects.find(p => p.id === cookieProject) || projects[0]

  if (activeProject) {
    channels = (await db.unsafe(
      `SELECT id, type, label, webhook_url, enabled, created_at
       FROM alert_channels WHERE project_id = $1 ORDER BY created_at DESC NULLS LAST, id`,
      [activeProject.id],
    )) ?? []
    members = (await db.unsafe(
      `SELECT m.id, m.email, m.role FROM project_members m
       WHERE m.project_id = $1 ORDER BY m.created_at ASC NULLS LAST, m.email`,
      [activeProject.id],
    )) ?? []
    invites = (await db.unsafe(
      `SELECT i.id, i.email, i.token, (u.id IS NOT NULL) AS registered
       FROM project_invites i LEFT JOIN users u ON lower(u.email) = lower(i.email)
       WHERE i.project_id = $1 ORDER BY i.created_at ASC NULLS LAST, i.email`,
      [activeProject.id],
    )) ?? []
  }
}
const projectId = activeProject?.id || null
const ownerEmail = (user && user.email) || ''

function maskWebhook(url: string): string {
  try {
    const u = new URL(url)
    return u.host + '/…' + String(url).slice(-4)
  }
  catch { return '…' }
}
function maskKey(k: string | null): string {
  const s = String(k || '')
  return s.length > 16 ? s.slice(0, 10) + '……' + s.slice(-4) : s
}
const channelView = channels.map(c => ({
  id: c.id,
  type: c.type,
  label: c.label || (c.type === 'slack' ? 'Slack' : 'Discord'),
  enabled: !!c.enabled,
  mask: maskWebhook(c.webhook_url),
}))
// INGEST_BASE, not APP_BASE: `/join/{token}` is registered in routes/projects.ts,
// which the API server owns. Same origin in production, so this is unchanged
// there — but in local dev APP_BASE is the web port, where the route does not
// exist, and every link this button copied 404'd. app/Invites/invites.ts builds
// the emailed link and had the identical bug; both now use the base that serves
// the route.
const JOIN_BASE = `${INGEST_BASE}/join/`
const memberView = members.map(m => ({ id: m.id, email: m.email }))
const inviteView = invites.map(i => ({ id: i.id, email: i.email, registered: !!i.registered, join: JOIN_BASE + i.token }))
const keyFull = activeProject ? String(activeProject.ingest_key || '') : ''
const keyMask = maskKey(keyFull)

// Framework-specific install snippet, keyed off the project's platform. Key-only
// (Flare-style): the ingest key alone identifies the project — no project id, no DSN.
// TEMPORARY: the snippet src points at the local ingest; switch to https://bughq.org/sdk.js at launch.
function installGuide(platform: string | null, key: string): InstallGuide {
  const p = String(platform || 'javascript').toLowerCase()
  const scriptTag = `<script src="${INGEST_BASE}/sdk.js"\n        data-key="${key}"><\/script>`
  if (p === 'vue')
    return { label: 'Vue', install: 'bun add @bughq/vue', code: `import BugHQ from '@bughq/vue'\n\napp.use(BugHQ, { key: '${key}' })` }
  if (p === 'nuxt')
    return { label: 'Nuxt', install: 'bun add @bughq/nuxt', code: `// nuxt.config.ts\nexport default defineNuxtConfig({\n  modules: ['@bughq/nuxt'],\n  bughq: { key: '${key}' },\n})` }
  if (p === 'node')
    return { label: 'Node.js', install: 'bun add @bughq/sdk', code: `import { bughq } from '@bughq/sdk'\n\nbughq.init({ key: '${key}' })` }
  if (p === 'react')
    return { label: 'React', install: 'bun add @bughq/sdk', code: `import { bughq } from '@bughq/sdk'\n\nbughq.init({ key: '${key}' })\n// then capture render errors from an ErrorBoundary` }
  if (p === 'javascript' || p === 'browser')
    return { label: 'JavaScript', install: '', code: scriptTag }
  if (p === 'laravel')
    return { label: 'Laravel', install: 'composer require bughq/bughq-laravel', code: `# .env\nBUGHQ_KEY=${key}\n\n# exceptions, failed jobs, and breadcrumbs are captured automatically` }
  if (p === 'php')
    return { label: 'PHP', install: 'composer require bughq/bughq', code: `use BugHQ\\BugHQ;\n\nBugHQ::init(['key' => '${key}']);` }
  return { label: 'HTML', install: '', code: scriptTag }
}
const guide = activeProject ? installGuide(activeProject.platform, keyFull) : { label: '', install: '', code: '' }

// Handed to the client block instead of being read back out of data-attributes
// and sibling textContent, so the copy buttons, key controls and danger zone
// need no DOM round-trip.
//
// Every one of them travels base64-encoded, and that is load-bearing. An HTML
// parser ends a script element at the first closing tag in its text, wherever
// that appears — it has no idea one is sitting inside a JS string. Two values
// here can contain such a tag:
//
//   - the JavaScript install snippet, which IS an sdk.js tag. On any project
//     whose platform is `javascript`, `browser` or the HTML default, this
//     truncated the whole client block at the assignment below, so every
//     control defined after it — reveal, rotate, members, alerts, archive,
//     delete — silently did not exist. Verified against a real project.
//   - the project name and channel labels, which users type. A project named
//     with a closing tag would do the same thing, and an opening one could
//     inject script into the page.
//
// stx bridges these into the client block itself: generateServerDataBridge
// (client-script.js:538) emits `var <name> = <json>` for every server-scope name
// the client references and does not redeclare, escaping `<` to \u003c on the
// way. That escape is the whole problem this file used to solve by hand — a
// closing script tag inside a value ends the element and truncates everything
// below it, which is what silently killed this page's controls on any project
// whose platform is `javascript`.
//
// So there is nothing to encode here. Name the value on the server, reference it
// in the client block, and do NOT redeclare it there — a client-side `const` of
// the same name makes the bridge skip it (declaresClientIdentifier).
const installText = guide.install || ''
const codeText = guide.code || ''
// Each channel's on/off state, seeded into a signal so the toggle renders from
// state rather than from a data-on attribute it also has to write back to.
const channelEnabled = Object.fromEntries(channelView.map(c => [c.id, c.enabled]))
// The danger zone used to read these back out of data-project-name / data-active
// on the panel. Passing them as values keeps the DOM out of it.
const projectName = activeProject?.name || ''

// Name the set that crosses into the client block, so the checker sees it.
//
// codeText and installText are the dangerous two: on a `javascript`, `browser`
// or default-HTML project the install snippet IS an sdk.js script tag, and an
// HTML parser ends a script element at the first closing tag in its text no
// matter where it sits. Declaring them here does not reintroduce that — the
// bridge escapes `<` to < on the way out (see the long note above) — and
// naming them makes it explicit which values carry that hazard rather than
// leaving it to whoever next reads the client block.
defineClientPayload({ channelEnabled, codeText, installText, justRotated, keyFull, keyMask, projectId, projectName })
</script>

<script client>
// Theme lives in the store: one implementation, shared across pages, and the
// pre-paint boot script in config/ui.ts already applied it before this ran.
const themeStore = useStore('theme')
const theme = themeStore.theme

function toggleTheme(): void {
  themeStore.toggle()
}


// One signal names whichever button most recently copied, so every Copy button
// on the page shares the same "Copied" affordance without any of them holding
// its own restore timer.
const copied = state('')

function copyLabel(which: string, done?: string, idle?: string): string {
  return copied() === which ? (done || 'Copied') : (idle || 'Copy')
}

// installText and codeText are used ONLY by the copy buttons in the markup.
// The bridge scans the client SCRIPT for a name before emitting it
// (client-script.js:544), not the template — so a value referenced only in an
// @click binding is silently never bridged and the binding resolves to
// undefined. Naming them in a handler here is what makes them cross.
function copyInstall(): void {
  copyText('install', installText)
}

function copyCode(): void {
  copyText('code', codeText)
}

function copyText(which: string, text: string): void {
  const mark = () => {
    copied.set(which)
    setTimeout(() => {
      if (copied() === which)
        copied.set('')
    }, 1400)
  }
  if (navigator.clipboard && navigator.clipboard.writeText && text)
    navigator.clipboard.writeText(text).then(mark, mark)
  else
    mark()
}

function switchProject(e: Event): void {
  useStore('session').project.set((e.target as HTMLSelectElement).value)
  window.location.href = '/settings'
}

// ---- API key -------------------------------------------------------------
const currentKey = state(keyFull)
const maskedKey = state(keyMask)
// Seeded from the server flag so a rotation's confirmation survives the reload
// that carries it: the new key is shown, not masked, because you have just been
// told to go and update your SDK config with it.
const revealed = state(justRotated)
const rotating = state(false)
const keyNote = state(justRotated ? { text: 'New key generated. Update your SDK config with it.', ok: true } : null)

function keyDisplay() {
  return revealed() ? currentKey() : maskedKey()
}

function toggleReveal() {
  revealed.set(!revealed())
}

function rotateKey() {
  const ask = window.stxConfirm
    ? window.stxConfirm('The current key stops working immediately — any SDK still sending it will get 401 until you update its config. Continue?', { title: 'Rotate API key?', confirmText: 'Rotate key', cancelText: 'Cancel', type: 'warning' })
    : Promise.resolve(window.confirm('Rotate the API key? The current key stops working immediately.'))
  Promise.resolve(ask).then((ok) => {
    if (!ok)
      return
    rotating.set(true)
    fetch(`/api/projects/${encodeURIComponent(projectId)}/rotate-key`, {
      method: 'POST',
      headers: authHeaders(),
    })
      .then((r) => r.json().then((b) => ({ ok: r.ok, b })))
      .then((res) => {
        rotating.set(false)
        if (!res.ok) {
          keyNote.set({ text: res.b.error || 'Rotate failed.', ok: false })
          return
        }
        // Reload rather than patch the key into the page, for the same reason
        // the invite flow does: the key is rendered into more places than the
        // field you are looking at. It is also in the masked view behind Hide
        // and, twice, in the install snippet — once as text and once as what
        // the snippet's Copy button puts on your clipboard. Updating only the
        // field left the rest showing the dead key, so rotating and then
        // copying the snippet handed you a key guaranteed to 401, which is the
        // exact thing the success note tells you to go and do.
        //
        // Patching them client-side was tried and reverted. The install snippet
        // for a browser project IS an sdk.js script tag, and making it reactive
        // took the whole client block down with it — every control on this page,
        // not just the snippet. The server already renders all four surfaces
        // correctly from one value; asking it again is cheaper and cannot drift.
        //
        // ?rotated=1 carries the confirmation across the reload so the note and
        // the revealed key survive it.
        const url = new URL(window.location.href)
        url.searchParams.set('rotated', '1')
        window.location.replace(url.toString())
      })
      .catch(() => {
        rotating.set(false)
        keyNote.set({ text: 'Network error.', ok: false })
      })
  })
}

// ---- Members and alert channels ------------------------------------------
// Both lists stay server-rendered. Each row already carries its own id, so
// removing one only has to hide that row — there is nothing to re-render, and
// no delegated listener walking up from the click target to work out which
// button was hit. `gone` holds the ids that have left; each row's @if reads it.
// Members and channels share it safely: ids are prefixed `mem_` and `ch_`.
const gone = state([])
const removing = state('')
const inviting = state(false)
const inviteNote = state(null)

function memberApi(path?: string): string {
  return `/api/projects/${encodeURIComponent(projectId)}/members${path || ''}`
}

function authHeaders(): AuthHeaders {
  return useStore('session').authHeaders()
}

function removeLabel(id: string): string {
  return removing() === id ? 'Removing…' : 'Remove'
}

function removeMember(id: string): void {
  if (removing())
    return
  removing.set(id)
  inviteNote.set(null)
  fetch(memberApi(`/${encodeURIComponent(id)}`), { method: 'DELETE', headers: authHeaders() })
    .then((r) => {
      removing.set('')
      if (r.ok)
        gone.set([...gone(), id])
      else
        inviteNote.set({ text: 'Could not remove that person.', ok: false })
    })
    .catch(() => {
      removing.set('')
      inviteNote.set({ text: 'Network error.', ok: false })
    })
}

function inviteMember(e: SubmitEvent): void {
  e.preventDefault()
  if (inviting())
    return
  const email = (e.target.elements.email.value || '').trim()
  if (!email) {
    inviteNote.set({ text: 'Enter an email address.', ok: false })
    return
  }
  inviting.set(true)
  inviteNote.set(null)
  fetch(memberApi(), { method: 'POST', headers: authHeaders(), body: JSON.stringify({ email }) })
    .then((r) => r.json().then((b) => ({ ok: r.ok, b })))
    .then((res) => {
      inviting.set(false)
      if (!res.ok) {
        inviteNote.set({ text: res.b.error || 'Could not invite.', ok: false })
        return
      }
      // The new row has to come back from the server. POST /members answers with
      // the email and join URL but no invite id, and without an id the row would
      // have no handle for a later Remove. Reloading is cheaper than inventing a
      // second round-trip to go find it.
      window.location.reload()
    })
    .catch(() => {
      inviting.set(false)
      inviteNote.set({ text: 'Network error.', ok: false })
    })
}

// ---- Alerts --------------------------------------------------------------
// The provider picker is one signal. Everything that used to be pushed into the
// DOM when it changed — both buttons' data-sel, the URL placeholder, the help
// text — is now read back out of it.
const HINTS = {
  slack: 'https://hooks.slack.com/services/…',
  discord: 'https://discord.com/api/webhooks/…',
}
const chType = state('slack')
const adding = state(false)
const whNote = state(null)

// Toggle state lives here rather than on a data-on attribute the handler both
// reads and writes, so a failed PATCH reverts by restoring a value instead of
// re-deriving the old one from the attribute it just overwrote.
const chEnabled = state(channelEnabled)
const testing = state('')
const tested = state(null)

function channelApi(path?: string): string {
  return `/api/projects/${encodeURIComponent(projectId)}/channels${path || ''}`
}

function urlPlaceholder(): string {
  return HINTS[chType()]
}

function isOn(id: string): boolean {
  return !!chEnabled()[id]
}

// Every channel id the server rendered is a key here, so the empty state can be
// reactive: removing the last row now shows it instead of leaving a blank gap.
function noChannels(): boolean {
  const ids = Object.keys(chEnabled())
  return ids.length === 0 || ids.every(id => gone().includes(id))
}

function toggleChannel(id: string): void {
  const next = !isOn(id)
  chEnabled.set({ ...chEnabled(), [id]: next })
  fetch(channelApi(`/${encodeURIComponent(id)}`), {
    method: 'PATCH',
    headers: authHeaders(),
    body: JSON.stringify({ enabled: next }),
  })
    .then((r) => {
      if (!r.ok)
        chEnabled.set({ ...chEnabled(), [id]: !next })
    })
    .catch(() => chEnabled.set({ ...chEnabled(), [id]: !next }))
}

function testLabel(id: string): string {
  if (testing() === id)
    return 'Sending…'
  const t = tested()
  return t && t.id === id ? t.text : 'Test'
}

function testChannel(id: string): void {
  if (testing())
    return
  testing.set(id)
  tested.set(null)
  fetch(channelApi(`/${encodeURIComponent(id)}/test`), { method: 'POST', headers: authHeaders() })
    .then((r) => {
      testing.set('')
      tested.set({ id, text: r.ok ? 'Sent ✓' : 'Failed' })
      setTimeout(() => {
        const t = tested()
        if (t && t.id === id)
          tested.set(null)
      }, 2400)
    })
    .catch(() => {
      testing.set('')
      tested.set({ id, text: 'Failed' })
    })
}

function removeChannel(id: string): void {
  if (removing())
    return
  removing.set(id)
  whNote.set(null)
  fetch(channelApi(`/${encodeURIComponent(id)}`), { method: 'DELETE', headers: authHeaders() })
    .then((r) => {
      removing.set('')
      if (r.ok)
        gone.set([...gone(), id])
      else
        whNote.set({ text: 'Could not remove that channel.', ok: false })
    })
    .catch(() => {
      removing.set('')
      whNote.set({ text: 'Network error.', ok: false })
    })
}

function addChannel(e: SubmitEvent): void {
  e.preventDefault()
  if (adding())
    return
  const form = e.target
  const url = (form.elements.webhook_url.value || '').trim()
  if (!url) {
    whNote.set({ text: 'Paste a webhook URL first.', ok: false })
    return
  }
  adding.set(true)
  whNote.set(null)
  fetch(channelApi(), {
    method: 'POST',
    headers: authHeaders(),
    body: JSON.stringify({ type: chType(), webhook_url: url, label: (form.elements.label.value || '').trim() }),
  })
    .then((r) => r.json().then((b) => ({ ok: r.ok, b })))
    .then((res) => {
      if (!res.ok) {
        adding.set(false)
        whNote.set({ text: res.b.error || 'Could not add that channel.', ok: false })
        return
      }
      // Same reason as an invite: the row has to come back from the server, which
      // is what masks the webhook URL. The response never echoes the secret.
      window.location.reload()
    })
    .catch(() => {
      adding.set(false)
      whNote.set({ text: 'Network error. Try again.', ok: false })
    })
}

// ---- Danger zone ---------------------------------------------------------
// One dialog serves both archive and delete. Which one is armed is a VALUE —
// 'archive' | 'delete' | null — not a callback stashed in a shared variable.
// That distinction is the point: previously the confirm button ran whatever
// mAction was last assigned, so the two destructive paths were separated only
// by assignment order. Now the button reads the same signal the title and copy
// read, and a stale one is unrepresentable.
const dzProjectName = projectName
const dzAction = state(null)
const dzTyped = state('')
/** The confirm-phrase input, for focus on open. Registered by ref="dzInput". */
const dzInput = useRef('dzInput')
const dzBusy = state(false)
const dzNote = state(null)
const unarchiving = state(false)

const DZ = {
  archive: {
    title: `Archive ${dzProjectName}?`,
    desc: 'bughq will stop capturing new errors and pause alerts for this project. Existing issues and events are kept, and you can unarchive anytime.',
    confirm: 'Archive project',
    busy: 'Archiving…',
  },
  delete: {
    title: `Delete ${dzProjectName}?`,
    desc: 'This permanently deletes the project and all of its issues, events, alert channels, and members. This cannot be undone.',
    confirm: 'Delete project',
    busy: 'Deleting…',
  },
}

function dzCopy(): { title: string, desc: string, confirm: string, busy: string } {
  return DZ[dzAction()] || { title: '', desc: '', confirm: '', busy: '' }
}

function dzOpen(which: 'archive' | 'delete'): void {
  dzAction.set(which)
  dzTyped.set('')
  dzNote.set(null)
  dzBusy.set(false)
  // Clearing the field is declarative now: the input binds :value="dzTyped()",
  // so the dzTyped.set('') above empties it. Only focus stays imperative, which
  // it has to be — there is no declarative form of "put the caret here" — and it
  // goes through a template ref rather than getElementById, so it cannot pick up
  // a stale element from a previous fragment.
  //
  // useRef(name) reads componentScope.$refs[name] and exposes `.current`; the
  // markup registers it with ref="dzInput" (signals.ts:1012, 2353). The 20ms
  // delay is unchanged — the field is inside a :hidden dialog and has to be
  // visible before it can take focus.
  setTimeout(() => {
    dzInput.current?.focus()
  }, 20)
}

function dzClose(): void {
  dzAction.set(null)
  dzTyped.set('')
  dzNote.set(null)
  dzBusy.set(false)
}

function dzType(e: Event): void {
  dzTyped.set(e.target.value)
}

// Escape is handled on the dialog, not on document. A document listener would
// outlive the fragment swap when you navigate away from /settings and stack up
// one dead handler per visit — the same leak class as the .shell bug.
function dzKey(e: KeyboardEvent): void {
  if (e.key === 'Escape')
    dzClose()
}

function dzBackdrop(e: MouseEvent): void {
  if (e.target === e.currentTarget)
    dzClose()
}

function dzMatches(): boolean {
  return dzTyped().trim() === dzProjectName
}

function dzConfirmLabel(): string {
  return dzBusy() ? dzCopy().busy : dzCopy().confirm
}

function dzConfirm(): void {
  // Re-checked here and not only through :disabled, because this is the last
  // gate before a project is destroyed.
  if (dzBusy() || !dzMatches())
    return
  const which = dzAction()
  dzBusy.set(true)
  dzNote.set(null)

  if (which === 'archive') {
    fetch(`/api/projects/${encodeURIComponent(projectId)}/archive`, {
      method: 'POST',
      headers: authHeaders(),
      body: JSON.stringify({ archived: true }),
    })
      .then((r) => {
        if (r.ok) {
          window.location.reload()
          return
        }
        dzBusy.set(false)
        dzNote.set({ text: 'Archive failed.', ok: false })
      })
      .catch(() => {
        dzBusy.set(false)
        dzNote.set({ text: 'Network error.', ok: false })
      })
    return
  }

  if (which === 'delete') {
    fetch(`/api/projects/${encodeURIComponent(projectId)}`, { method: 'DELETE', headers: authHeaders() })
      .then((r) => {
        if (!r.ok) {
          dzBusy.set(false)
          dzNote.set({ text: 'Delete failed.', ok: false })
          return
        }
        // The project this page is scoped to no longer exists, so the cookie
        // pointing at it has to go before the next page tries to resolve it.
        useStore('session').project.set('')
        window.location.assign('/projects')
      })
      .catch(() => {
        dzBusy.set(false)
        dzNote.set({ text: 'Network error.', ok: false })
      })
  }
}

// Unarchiving is not destructive, so it stays outside the confirm dialog.
function unarchive(): void {
  if (unarchiving())
    return
  unarchiving.set(true)
  fetch(`/api/projects/${encodeURIComponent(projectId)}/archive`, {
    method: 'POST',
    headers: authHeaders(),
    body: JSON.stringify({ archived: false }),
  })
    .then((r) => {
      if (r.ok)
        window.location.reload()
      else
        unarchiving.set(false)
    })
    .catch(() => unarchiving.set(false))
}
</script>


<style>
html { scroll-behavior: smooth; }
.wordmark-link { color: inherit; text-decoration: none; transition: opacity 0.15s ease; }
.wordmark-link:hover { opacity: 0.75; }
.sec { scroll-margin-top: 84px; }
.sec-title { font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-3); }
.btn { background: var(--accent); color: #fff; border-radius: 10px; transition: background 0.15s ease, opacity 0.15s ease; }
.btn:hover { background: color-mix(in srgb, var(--accent) 88%, #000); }
.btn:disabled { opacity: 0.55; cursor: default; }
.btn-ghost { border: 1px solid var(--border); color: var(--text-2); border-radius: 9px; background: var(--panel); transition: color 0.15s ease, border-color 0.15s ease; }
.btn-ghost:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.btn-danger { border: 1px solid color-mix(in srgb, var(--warn) 45%, var(--border)); color: var(--warn); border-radius: 9px; background: var(--panel); transition: all 0.15s ease; }
.btn-danger:hover { color: #fff; background: var(--warn); border-color: var(--warn); }
.field:focus { outline: none; border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); }
.badge { border-radius: 999px; font-size: 11px; font-weight: 600; letter-spacing: 0.02em; padding: 2px 9px; }
.badge-slack { color: #fff; background: var(--slack); }
.badge-discord { color: #fff; background: var(--discord); }
.badge-soft { background: color-mix(in srgb, var(--accent) 14%, var(--panel)); color: var(--accent); }
.badge-owner { background: color-mix(in srgb, var(--accent) 16%, var(--panel)); color: var(--accent); }
.badge-pending { background: color-mix(in srgb, var(--text-3) 18%, var(--panel)); color: var(--text-2); }
.tgl { width: 38px; height: 22px; border-radius: 999px; background: var(--border); position: relative; transition: background 0.15s ease; cursor: pointer; flex: none; }
.tgl::after { content: ''; position: absolute; top: 2px; left: 2px; width: 18px; height: 18px; border-radius: 999px; background: #fff; transition: transform 0.15s ease; }
.tgl[data-on="1"] { background: var(--ok); }
.tgl[data-on="1"]::after { transform: translateX(16px); }
.seg { border: 1px solid var(--border); border-radius: 10px; color: var(--text-2); background: var(--panel); transition: all 0.12s ease; }
.seg[data-sel="1"] { color: #fff; border-color: transparent; }
.seg-slack[data-sel="1"] { background: var(--slack); }
.seg-discord[data-sel="1"] { background: var(--discord); }
.note { display: none; }
.note.show { display: block; }
/* Colour variants for notes rendered from signals, so the state is a class
   rather than an inline style assignment. */
.note-ok { color: var(--ok); }
.note-err { color: var(--accent); }
.theme-btn .ic-sun, .theme-btn .ic-moon { display: none; }
.theme-btn[data-t="light"] .ic-sun { display: block; }
.theme-btn[data-t="dark"] .ic-moon { display: block; }
.tabnav a { color: var(--text-2); border: 1px solid var(--border); border-radius: 999px; transition: color .15s ease, border-color .15s ease; }
.tabnav a:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.danger-panel { border-color: color-mix(in srgb, var(--warn) 40%, var(--border)); }
.code-block { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; color: var(--text-2); font-family: var(--mono); font-size: 12px; line-height: 1.5; padding: 12px 16px; padding-right: 64px; overflow-x: auto; }
.copy-btn { position: absolute; top: 8px; right: 8px; font: 500 11px/1 var(--sans); padding: 5px 9px; border-radius: 7px; border: 1px solid var(--border); background: var(--panel); color: var(--text-3); cursor: pointer; transition: color .15s ease, border-color .15s ease; }
.copy-btn:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.dz-div { height: 1px; background: color-mix(in srgb, var(--warn) 20%, var(--border)); }
.dz-overlay { position: fixed; inset: 0; z-index: 60; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgba(2,4,10,0.62); backdrop-filter: blur(3px); animation: dz-fade 0.12s ease; }
.dz-overlay[hidden] { display: none; }
.dz-card { width: 100%; max-width: 440px; padding: 22px; box-shadow: 0 24px 70px rgba(0,0,0,0.5); animation: dz-pop 0.14s cubic-bezier(0.2,0.8,0.3,1); }
@keyframes dz-fade { from { opacity: 0 } to { opacity: 1 } }
@keyframes dz-pop { from { opacity: 0; transform: translateY(6px) scale(0.98) } to { opacity: 1; transform: none } }
</style>

<div class="min-h-[100dvh] px-5 py-10 md:px-10">
  <div class="max-w-2xl mx-auto">

    <header class="flex items-center justify-between gap-4 mb-7">
      <StxLink to="/projects" class="wordmark-link"><h1 class="wordmark text-2xl leading-none">bughq</h1></StxLink>
      <div class="flex items-center gap-2">
        <button class="icon-btn theme-btn" :data-t="theme()" @click="toggleTheme" title="Toggle theme" aria-label="Toggle theme">
          <svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <StxLink to="/dashboard" class="btn-ghost px-3.5 py-2 text-sm font-medium">← Dashboard</StxLink>
      </div>
    </header>

    @if (!user)
      <div id="auth-pending" class="text-center py-24 text-sm text-subtle">Loading…</div>
    @endif

    @if (needsOnboarding)
      <script>window.location.replace('/projects/new')</script>
    @endif

    @if (user && activeProject)
      <div class="mb-6">
        <div class="flex items-center gap-3 flex-wrap">
          <h2 class="text-xl font-semibold" style="letter-spacing:-0.02em">Settings</h2>
          @if (projects.length > 1)
            <select @change="switchProject" class="panel mono px-3 py-1.5 text-sm text-muted">
              @foreach (projects as p)
                <option value="{{ p.id }}" {{ p.id === projectId ? 'selected' : '' }}>{{ p.name }}</option>
              @endforeach
            </select>
          @else
            <span class="mono text-sm text-muted">{{ activeProject.name }}</span>
          @endif
        </div>
        <p class="text-sm mt-1.5 text-subtle">Manage the API key, team, alerts, and deletion for this project.</p>
      </div>

      <nav class="tabnav flex items-center gap-2 mb-8 text-sm">
        <a href="#install" class="px-3 py-1.5 font-medium">Install</a>
        <a href="#keys" class="px-3 py-1.5 font-medium">Keys</a>
        <a href="#members" class="px-3 py-1.5 font-medium">Members</a>
        <a href="#alerts" class="px-3 py-1.5 font-medium">Alerts</a>
        <a href="#danger" class="px-3 py-1.5 font-medium">Danger</a>
      </nav>

      <!-- ============================ INSTALL ============================ -->
      <section id="install" class="sec mb-10">
        <div class="sec-title mb-3">Install</div>
        <div class="panel px-5 py-5">
          <div class="flex items-center justify-between gap-3 mb-3.5">
            <p class="text-sm text-subtle">Wire bughq into <span class="mono text-muted">{{ activeProject.name }}</span> to start capturing errors — they group into issues automatically.</p>
            <span class="badge badge-soft shrink-0">{{ guide.label }}</span>
          </div>
          @if (guide.install)
            <div class="relative mb-2">
              <div class="code-block">{{ guide.install }}</div>
              <button type="button" class="copy-btn" @click="copyInstall" :text="copyLabel('install')">Copy</button>
            </div>
          @endif
          <div class="relative">
            <div class="code-block" style="white-space: pre">{{ guide.code }}</div>
            <button type="button" class="copy-btn" @click="copyCode" :text="copyLabel('code')">Copy</button>
          </div>
        </div>
      </section>

      <!-- ============================ KEYS ============================ -->
      <section id="keys" class="sec mb-10">
        <div class="sec-title mb-3">API key</div>
        <div class="panel px-5 py-5">
          <p class="text-sm mb-4 text-subtle">
            This key authorizes error reports for <span class="mono text-muted">{{ activeProject.name }}</span>.
            It's a public identifier (safe to ship in client code), not a secret — it says <em>which</em> project a report belongs to.
          </p>
          <div class="flex items-center gap-2 flex-wrap">
            <code :text="keyDisplay()" class="field mono px-3.5 py-2.5 text-sm flex-1 min-w-[220px] truncate" style="letter-spacing:0.01em">{{ keyMask }}</code>
            <button @click="toggleReveal" :text="revealed() ? 'Hide' : 'Reveal'" class="btn-ghost px-3 py-2 text-sm font-medium">Reveal</button>
            <button @click="copyText('key', currentKey())" :text="copyLabel('key')" class="btn-ghost px-3 py-2 text-sm font-medium">Copy</button>
            <button @click="rotateKey" :disabled="rotating()" class="btn-danger px-3 py-2 text-sm font-medium">Rotate</button>
          </div>
          <p class="text-xs mt-3.5 leading-relaxed text-subtle">
            Rotating generates a new key and <span style="color: var(--warn)">invalidates the current one immediately</span> — any SDK still sending the old key will get 401 until you update its config (<span class="mono">BUGHQ_KEY</span> / <span class="mono">data-key</span>).
          </p>
          @if (keyNote() && keyNote().ok)
            <span class="note show note-ok text-xs mt-2" :text="keyNote().text"></span>
          @endif
          @if (keyNote() && !keyNote().ok)
            <span class="note show note-err text-xs mt-2" :text="keyNote().text"></span>
          @endif
        </div>
      </section>

      <!-- ============================ MEMBERS ============================ -->
      <section id="members" class="sec mb-10">
        <div class="sec-title mb-3">Members</div>
        <div class="flex flex-col gap-2.5 mb-4">
          <!-- Owner (always first, not removable) -->
          <div class="panel flex items-center gap-3.5 px-4 py-3.5">
            <span class="w-8 h-8 rounded-lg shrink-0 grid place-items-center font-semibold badge-owner">{{ (ownerEmail || '?').charAt(0).toUpperCase() }}</span>
            <div class="min-w-0 flex-1">
              <div class="text-sm font-medium truncate">{{ ownerEmail }}</div>
              <div class="text-xs mt-0.5 text-subtle">Full access</div>
            </div>
            <span class="badge badge-owner">Owner</span>
          </div>
          @foreach (memberView as m)
            <div class="panel flex items-center gap-3.5 px-4 py-3.5" @if="!gone().includes('{{ m.id }}')">
              <span class="w-8 h-8 rounded-lg shrink-0 grid place-items-center font-semibold text-muted" style="background: color-mix(in srgb, var(--text-3) 16%, var(--panel))">{{ (m.email || '?').charAt(0).toUpperCase() }}</span>
              <div class="min-w-0 flex-1">
                <div class="text-sm font-medium truncate">{{ m.email }}</div>
                <div class="text-xs mt-0.5 text-subtle">Can view &amp; triage issues</div>
              </div>
              <span class="badge badge-soft">Member</span>
              <button @click="removeMember('{{ m.id }}')" :disabled="removing() === '{{ m.id }}'" :text="removeLabel('{{ m.id }}')" class="btn-danger px-2.5 py-1.5 text-xs font-medium" title="Remove">Remove</button>
            </div>
          @endforeach
          @foreach (inviteView as i)
            <div class="panel flex items-center gap-3.5 px-4 py-3.5" @if="!gone().includes('{{ i.id }}')">
              <span class="w-8 h-8 rounded-lg shrink-0 grid place-items-center font-semibold text-subtle" style="background: color-mix(in srgb, var(--text-3) 12%, var(--panel))">{{ (i.email || '?').charAt(0).toUpperCase() }}</span>
              <div class="min-w-0 flex-1">
                <div class="text-sm font-medium truncate">{{ i.email }}</div>
                <div class="text-xs mt-0.5 text-subtle">{{ i.registered ? 'Has an account — pending accept' : 'Invite sent — awaiting sign-up' }}</div>
              </div>
              <span class="badge badge-pending" title="Pending — becomes a member once they accept">Invited</span>
              <button @click="copyText('join-{{ i.id }}', '{{ i.join }}')" :text="copyLabel('join-{{ i.id }}', 'Copied ✓', 'Copy link')" class="btn-ghost px-2.5 py-1.5 text-xs font-medium" title="Copy join link">Copy link</button>
              <button @click="removeMember('{{ i.id }}')" :disabled="removing() === '{{ i.id }}'" :text="removeLabel('{{ i.id }}')" class="btn-danger px-2.5 py-1.5 text-xs font-medium" title="Revoke invite">Remove</button>
            </div>
          @endforeach
        </div>
        <div class="panel px-5 py-5">
          <div class="text-sm font-semibold mb-3">Invite a teammate</div>
          <form @submit="inviteMember">
            <div class="flex items-center gap-2 flex-wrap">
              <input name="email" type="email" class="field flex-1 min-w-[220px] px-3.5 py-2.5 text-sm" placeholder="teammate@company.com" autocomplete="off">
              <button type="submit" :disabled="inviting()" :text="inviting() ? 'Inviting…' : 'Invite'" class="btn px-4 py-2.5 text-sm font-semibold">Invite</button>
            </div>
          </form>
          @if (inviteNote() && inviteNote().ok)
            <span class="note show note-ok text-xs mt-2.5" :text="inviteNote().text"></span>
          @endif
          @if (inviteNote() && !inviteNote().ok)
            <span class="note show note-err text-xs mt-2.5" :text="inviteNote().text"></span>
          @endif
          <p class="text-xs mt-3.5 leading-relaxed text-subtle">
            We email them a join link. They sign up (or log in) with that email, then accept from a banner in the app. Members can view and triage issues; only you can manage keys, members, and deletion.
          </p>
        </div>
      </section>

      <!-- ============================ ALERTS ============================ -->
      <section id="alerts" class="sec mb-10">
        <div class="sec-title mb-3">Alerts</div>
        <p class="text-sm mb-4 text-subtle">
          Get pinged in Slack or Discord on a new issue or a regression. The project owner is always emailed too.
        </p>
        {{-- The toggle carries both `:data-on` and a plain `data-on`, and that is
             not redundant: stx leaves `:attr` for the client runtime to apply, so
             the static value is what the switch renders with until then. Same
             pairing on the URL input's placeholder below. --}}
        <div class="flex flex-col gap-2.5 mb-4">
          @foreach (channelView as c)
            <div class="panel flex items-center gap-3.5 px-4 py-3.5" @if="!gone().includes('{{ c.id }}')">
              <span class="badge badge-{{ c.type }}">{{ c.type === 'slack' ? 'Slack' : 'Discord' }}</span>
              <div class="min-w-0 flex-1">
                <div class="text-sm font-medium truncate">{{ c.label }}</div>
                <div class="text-xs mono truncate mt-0.5 text-subtle">{{ c.mask }}</div>
              </div>
              <button @click="testChannel('{{ c.id }}')" :disabled="testing() === '{{ c.id }}'" :text="testLabel('{{ c.id }}')" class="btn-ghost px-2.5 py-1.5 text-xs font-medium" title="Send a test message">Test</button>
              <div class="tgl" @click="toggleChannel('{{ c.id }}')" :data-on="isOn('{{ c.id }}') ? '1' : '0'" :aria-checked="isOn('{{ c.id }}') ? 'true' : 'false'" data-on="{{ c.enabled ? '1' : '0' }}" role="switch" aria-checked="{{ c.enabled ? 'true' : 'false' }}" title="Enable / disable"></div>
              <button @click="removeChannel('{{ c.id }}')" :disabled="removing() === '{{ c.id }}'" :text="removeLabel('{{ c.id }}')" class="btn-danger px-2.5 py-1.5 text-xs font-medium" title="Remove">Remove</button>
            </div>
          @endforeach
          <div class="panel px-5 py-8 text-center" @if="noChannels()">
            <div class="text-sm font-medium mb-1">No chat alerts yet</div>
            <div class="text-xs text-subtle">Add a Slack or Discord webhook below to start getting pinged.</div>
          </div>
        </div>
        <div class="panel px-5 py-5">
          <div class="text-sm font-semibold mb-3.5">Add a channel</div>
          <form @submit="addChannel">
            <div class="grid grid-cols-2 gap-2 mb-3">
              <button type="button" @click="chType.set('slack')" :data-sel="chType() === 'slack' ? '1' : '0'" class="seg seg-slack px-3 py-2.5 text-sm font-medium" data-sel="1">Slack</button>
              <button type="button" @click="chType.set('discord')" :data-sel="chType() === 'discord' ? '1' : '0'" class="seg seg-discord px-3 py-2.5 text-sm font-medium" data-sel="0">Discord</button>
            </div>
            <input name="webhook_url" type="url" class="field w-full px-3.5 py-2.5 text-sm mono mb-2" :placeholder="urlPlaceholder()" placeholder="https://hooks.slack.com/services/…" autocomplete="off" spellcheck="false">
            <input name="label" type="text" class="field w-full px-3.5 py-2.5 text-sm mb-3" placeholder="Label (optional) — e.g. #alerts" maxlength="255">
            <div class="flex items-center gap-3">
              <button type="submit" :disabled="adding()" :text="adding() ? 'Adding…' : 'Add channel'" class="btn px-4 py-2.5 text-sm font-semibold">Add channel</button>
              @if (whNote() && whNote().ok)
                <span class="note show note-ok text-xs" :text="whNote().text"></span>
              @endif
              @if (whNote() && !whNote().ok)
                <span class="note show note-err text-xs" :text="whNote().text"></span>
              @endif
            </div>
          </form>
          {{-- Both provider hints are markup rather than one element whose
               textContent gets swapped, so Discord keeps the same styling Slack
               has instead of degrading to plain text on the first switch. --}}
          @if (chType() === 'slack')
            <p class="text-xs mt-3.5 leading-relaxed text-subtle">
              In Slack: <span class="text-muted">Apps → Incoming Webhooks → Add to a channel</span>, then paste the <span class="mono">hooks.slack.com/services/…</span> URL.
            </p>
          @endif
          @if (chType() === 'discord')
            <p class="text-xs mt-3.5 leading-relaxed text-subtle">
              In Discord: <span class="text-muted">Server Settings → Integrations → Webhooks → New Webhook</span>, then copy the <span class="mono">discord.com/api/webhooks/…</span> URL.
            </p>
          @endif
        </div>
      </section>

      <!-- ============================ DANGER ============================ -->
      <section id="danger" class="sec mb-6">
        <div class="sec-title mb-3" style="color: var(--warn)">Danger zone</div>
        <div class="panel danger-panel">
          <!-- Archive / Unarchive -->
          <div class="flex items-center justify-between gap-4 px-5 py-4">
            <div class="min-w-0">
              @if (activeProject.is_active === false)
                <div class="text-sm font-semibold mb-0.5">Unarchive this project</div>
                <p class="text-sm text-subtle"><span class="mono text-muted">{{ activeProject.name }}</span> is archived and isn’t capturing new errors. Unarchiving resumes ingestion right away.</p>
              @else
                <div class="text-sm font-semibold mb-0.5">Archive this project</div>
                <p class="text-sm text-subtle">Stops capturing new errors and pauses alerts for <span class="mono text-muted">{{ activeProject.name }}</span>. Existing issues and events are kept — you can unarchive anytime.</p>
              @endif
            </div>
            @if (activeProject.is_active === false)
              <button @click="unarchive" :disabled="unarchiving()" :text="unarchiving() ? 'Unarchiving…' : 'Unarchive'" class="btn-danger px-4 py-2.5 text-sm font-semibold whitespace-nowrap flex-none">Unarchive</button>
            @else
              <button @click="dzOpen('archive')" class="btn-danger px-4 py-2.5 text-sm font-semibold whitespace-nowrap flex-none">Archive</button>
            @endif
          </div>
          <div class="dz-div"></div>
          <!-- Delete -->
          <div class="flex items-center justify-between gap-4 px-5 py-4">
            <div class="min-w-0">
              <div class="text-sm font-semibold mb-0.5">Delete this project</div>
              <p class="text-sm text-subtle">Permanently deletes <span class="mono text-muted">{{ activeProject.name }}</span> and all of its issues, events, alert channels, and members. This cannot be undone.</p>
            </div>
            <button @click="dzOpen('delete')" class="btn-danger px-4 py-2.5 text-sm font-semibold whitespace-nowrap flex-none">Delete</button>
          </div>
        </div>
      </section>

      <!-- Confirm modal (archive / delete): type the project name to confirm -->
      {{-- `:hidden` rather than `@if`: the SSR pass renders the plain `hidden`
           attribute so the overlay is closed on arrival with no cloak flash, and
           the runtime keeps it in step from there. Keeping the dialog mounted is
           also what lets dzOpen focus the field. --}}
      <div class="dz-overlay" :hidden="dzAction() === null" hidden @click="dzBackdrop" @keydown="dzKey">
        <div class="dz-card panel" role="dialog" aria-modal="true" aria-labelledby="dz-title">
          <div id="dz-title" class="text-base font-semibold mb-1" :text="dzCopy().title"></div>
          <p class="text-sm mb-4 text-muted" :text="dzCopy().desc"></p>
          <label class="block text-xs mb-1.5 text-subtle">Type <span class="mono text-muted">{{ activeProject.name }}</span> to confirm</label>
          <input ref="dzInput" type="text" class="field w-full px-3.5 py-2.5 text-sm mono mb-4" :value="dzTyped()" @input="dzType" autocomplete="off" autocapitalize="off" spellcheck="false">
          <div class="flex items-center justify-end gap-2">
            <button @click="dzClose" type="button" class="btn-ghost px-4 py-2.5 text-sm font-medium">Cancel</button>
            <button @click="dzConfirm" :disabled="dzBusy() || !dzMatches()" :text="dzConfirmLabel()" type="button" class="btn-danger px-4 py-2.5 text-sm font-semibold" disabled></button>
          </div>
          @if (dzNote())
            <span class="note show note-err text-xs mt-2.5" :text="dzNote().text"></span>
          @endif
        </div>
      </div>
    @endif

  </div>
</div>

<script>
// Auth guard. Stays a plain blocking script rather than a client block: it has
// to run before the page is worth rendering, and its whole job is to leave —
// either to /login or through a reload once the cookie mirrors localStorage,
// which server-rendered pages authenticate from.
(function () {
  // The bughq_token cookie is the single source of truth: it is what every
  // <script server> block authenticates from, and the store writes it at sign-in.
  // This guard only has to notice its absence and leave. It used to read a
  // localStorage copy, mirror it into the cookie and reload — a second source for
  // the same fact, with nothing keeping the two in step.
  //
  // Raw document.cookie because this is a bare <script> that runs before the
  // signals runtime exists, so useStore is not defined yet.
  if (!/(^|;)\s*bughq_token=/.test(document.cookie)) { window.location.replace('/login'); return }
  // The cookie WAS sent but the server still rendered the unauthenticated
  // state, so the token is dead — expired, revoked, or replaced by a newer
  // login. The presence test above cannot see that, because a dead token is
  // still a present cookie. Clear it and go to login; without this the page
  // wedges on "Loading…" with no fetch pending to ever replace it. Same
  // recovery as dashboard.stx, which had it first.
  if (document.getElementById('auth-pending')) {
    document.cookie = 'bughq_token=; path=/; max-age=0'
    window.location.replace('/login')
    return
  }
})()
</script>
