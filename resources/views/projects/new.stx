<script server>
useSeoMeta({
  title: 'New app - bughq',
  // Auth-walled. Keeps it out of the index and, with the site.config
  // entry removed, stops a canonical being minted for a URL nobody
  // signed out can load.
  robots: 'noindex, nofollow',
})
</script>

<script client>
// Create-app screen. New users land here after signup. Creates a project via
// the authenticated API (bearer from localStorage), then drops into that
// project's dashboard, where the ingest snippet + key are shown.
const error = state('')
const loading = state(false)

function ensureAuthed() {
  const t = useStore('session').token()
  if (!t) {
    window.location.replace('/login')
    return
  }
  // Nothing to mirror: token() reads the cookie, so if it is non-empty the
  // cookie already exists and the server will see it.
}
ensureAuthed()

// Reading an uncontrolled field is two narrowings: `e.target` is an EventTarget
// and `form.elements` hands back Elements, and neither of those carries a
// `.value`. This form reads both an input (name) and a select (platform); a
// field the markup does not contain reads as empty rather than throwing.
function fieldValue(form: HTMLFormElement, name: string): string {
  const el = form.elements.namedItem(name)
  return el instanceof HTMLInputElement || el instanceof HTMLSelectElement ? el.value : ''
}

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target
  if (!(form instanceof HTMLFormElement))
    return
  const name = fieldValue(form, 'name').trim()
  if (!name) {
    error.set('Give your app a name.')
    return
  }
  loading.set(true)
  error.set('')
  try {
    const res = await fetch('/api/projects', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': useStore('session').authHeaders().Authorization,
      },
      body: JSON.stringify({ name, platform: fieldValue(form, 'platform') }),
    })
    const data = await res.json().catch(() => ({}))
    if (res.status === 401) {
      window.location.replace('/login')
      return
    }
    if (!res.ok) {
      error.set(data.error || 'Could not create the app.')
      loading.set(false)
      return
    }
    // Straight into the new project's Settings → Install, where the setup snippet lives.
    window.location.assign(`/settings?project=${encodeURIComponent(data.project.id)}`)
  }
  catch {
    error.set('Something went wrong. Please try again.')
    loading.set(false)
  }
}
</script>


<style>
.field:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent); }
.err { background: color-mix(in srgb, #ef4444 12%, transparent); color: #ef4444; }
</style>

<div class="min-h-[100dvh] flex items-center justify-center px-5 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <a href="/" class="wordmark text-2xl">bughq</a>
    </div>

    <div class="text-center mb-8">
      <h1 class="text-xl font-semibold tracking-tight">Create your first app</h1>
      <p class="text-sm mt-2 text-subtle">Each app gets its own error stream and ingest key.</p>
    </div>

    <form @submit="handleSubmit" class="space-y-4">
      @if (error())
        <div class="err text-sm rounded-lg px-3 py-2">{{ error() }}</div>
      @endif

      <div>
        <label for="new-app-name" class="block text-xs font-medium mb-1.5 text-muted">App name</label>
        <input name="name" id="new-app-name" type="text" required autofocus placeholder="Acme Web" class="field w-full px-3.5 py-2.5 text-sm">
      </div>
      <div>
        <label for="new-app-platform" class="block text-xs font-medium mb-1.5 text-muted">Platform</label>
        <select name="platform" id="new-app-platform" class="field w-full px-3.5 py-2.5 text-sm">
          <option value="javascript">JavaScript / Browser</option>
          <option value="node">Node.js</option>
          <option value="react">React</option>
          <option value="vue">Vue</option>
          <option value="nuxt">Nuxt</option>
          <option value="laravel">Laravel</option>
          <option value="php">PHP</option>
          <option value="other">Other</option>
        </select>
      </div>

      <button type="submit" :disabled="loading()" class="btn-accent w-full py-2.5 text-sm font-semibold">
        {{ loading() ? 'Creating…' : 'Create app' }}
      </button>
    </form>
  </div>
</div>
