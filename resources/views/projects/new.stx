<script server>
useSeoMeta({
  title: 'New app - bughq',
  // Auth-walled. Keeps it out of the index and, with the site.config
  // entry removed, stops a canonical being minted for a URL nobody
  // signed out can load.
  robots: 'noindex, nofollow',
})

const { db } = await import('@stacksjs/database')

// Authenticate the render, like every other auth-walled page here. This screen
// used to be the one that did not: it rendered the form to anybody and only
// discovered a dead token from the 401 on submit — i.e. after you had typed a
// name and picked a platform, both of which the redirect then threw away. The
// cookie is present in both cases, so only resolving it tells the two apart.
const token = (typeof requestContext !== 'undefined' && requestContext.cookie && requestContext.cookie('bughq_token')) || ''
let user = null
if (token) {
  try {
    const { Auth } = await import('@stacksjs/auth')
    user = await Auth.getUserFromToken(token)
  }
  catch { user = null }
}

// Owned OR joined — the scope /projects and the dashboard switcher both call
// "your apps", so the heading agrees with the page you arrived from. A count,
// not the rows: nothing on this screen renders an app, only whether any exist.
let projectCount = 0
let ownedCount = 0
let atProjectLimit = false
let freeProjects = 5
if (user) {
  const counted = (await db.unsafe(
    `SELECT COUNT(DISTINCT p.id) AS n
     FROM projects p
     LEFT JOIN project_members m ON m.project_id = p.id AND lower(m.email) = $2
     WHERE p.owner_id = $1 OR m.email IS NOT NULL`,
    [Number(user.id), String(user.email ?? '').toLowerCase()],
  ))?.[0]
  projectCount = Number(counted?.n ?? 0)

  // OWNED projects, not accessible ones. The count above includes projects
  // shared with you, which is right for the heading but wrong for the cap —
  // being invited to someone else's project must not use up your own quota.
  const ownedRow = (await db.unsafe(
    'SELECT COUNT(*) AS n FROM projects WHERE owner_id = $1',
    [Number(user.id)],
  ))?.[0]
  ownedCount = Number(ownedRow?.n ?? 0)

  // Ask before the user fills the form in. The API refuses this anyway
  // (routes/projects.ts, 402), but discovering a limit by having your work
  // rejected is a worse way to learn it than being told up front.
  const { isPro } = await import('../../../app/Billing/pro')
  const { FREE_PROJECTS } = await import('../../../app/Billing/plans')
  atProjectLimit = !(await isPro(Number(user.id))) && ownedCount >= FREE_PROJECTS
  freeProjects = FREE_PROJECTS
}
</script>

<script client>
// Create-app screen. New users land here after signup. Creates a project via
// the authenticated API (bearer from localStorage), then drops into that
// project's dashboard, where the ingest snippet + key are shown.
const error = state('')
const loading = state(false)

// The "are you signed in" check used to live here as an ensureAuthed() that ran
// after hydration and only tested that the cookie was non-empty — which a dead
// token also is. It is now the pre-paint guard at the bottom of this file,
// reading the server's own verdict. The 401 branch in handleSubmit stays: a
// token can still die between render and submit.

// Reading an uncontrolled field is two narrowings: `e.target` is an EventTarget
// and `form.elements` hands back Elements, and neither of those carries a
// `.value`. This form reads both an input (name) and a select (platform); a
// field the markup does not contain reads as empty rather than throwing.
function fieldValue(form: HTMLFormElement, name: string): string {
  const el = form.elements.namedItem(name)
  return el instanceof HTMLInputElement || el instanceof HTMLSelectElement ? el.value : ''
}

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target
  if (!(form instanceof HTMLFormElement))
    return
  const name = fieldValue(form, 'name').trim()
  if (!name) {
    error.set('Give your app a name.')
    return
  }
  loading.set(true)
  error.set('')
  try {
    const res = await fetch('/api/projects', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': useStore('session').authHeaders().Authorization,
      },
      body: JSON.stringify({ name, platform: fieldValue(form, 'platform') }),
    })
    const data = await res.json().catch(() => ({}))
    if (res.status === 401) {
      window.location.replace('/login')
      return
    }
    if (!res.ok) {
      error.set(data.error || 'Could not create the app.')
      loading.set(false)
      return
    }
    // Straight into the new project's Settings → Install, where the setup snippet
    // lives. navigate(), not location.assign: both pages are in the `default`
    // layout group, so this is a fragment swap rather than a full document load.
    // The target URL differs from the current one, so the router's same-URL
    // no-op (the reason the project switchers still reload) does not apply.
    navigate(`/settings?project=${encodeURIComponent(data.project.id)}`)
  }
  catch {
    error.set('Something went wrong. Please try again.')
    loading.set(false)
  }
}
</script>


<style>
.limit-note { border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border)); background: color-mix(in srgb, var(--accent) 8%, transparent); color: var(--text-2); margin-bottom: 0.75rem; }
.field:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent); }
.err { background: color-mix(in srgb, #ef4444 12%, transparent); color: #ef4444; }
</style>

<div class="min-h-[100dvh] flex items-center justify-center px-5 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <a href="/" class="wordmark text-2xl">bughq</a>
    </div>

    @if (!user)
      <div id="auth-pending" class="text-center py-24 text-sm text-subtle">Loading…</div>
    @endif

    @if (user)
    <div class="text-center mb-8">
      {{-- "your first" is a claim about the account, and it was hardcoded, so it
           greeted people on their fifth app too. projectCount is the same
           owned-or-joined scope /projects counts. --}}
      <h1 class="text-xl font-semibold tracking-tight">{{ projectCount === 0 ? 'Create your first app' : 'Create a new app' }}</h1>
      <p class="text-sm mt-2 text-subtle">Each app gets its own error stream and ingest key.</p>
    </div>

    <form @submit="handleSubmit" class="space-y-4">
      @if (error())
        <div class="err text-sm rounded-lg px-3 py-2">{{ error() }}</div>
      @endif

      <div>
        <label for="new-app-name" class="block text-xs font-medium mb-1.5 text-muted">App name</label>
        <input name="name" id="new-app-name" type="text" required autofocus placeholder="Acme Web" class="field w-full px-3.5 py-2.5 text-sm">
      </div>
      <div>
        <label for="new-app-platform" class="block text-xs font-medium mb-1.5 text-muted">Platform</label>
        <select name="platform" id="new-app-platform" class="field w-full px-3.5 py-2.5 text-sm">
          <option value="javascript">JavaScript / Browser</option>
          <option value="node">Node.js</option>
          <option value="react">React</option>
          <option value="vue">Vue</option>
          <option value="nuxt">Nuxt</option>
          <option value="stacks">Stacks</option>
          <option value="laravel">Laravel</option>
          <option value="php">PHP</option>
          <option value="other">Other</option>
        </select>
      </div>

      @if (atProjectLimit)
        <div class="limit-note text-sm rounded-[10px] px-4 py-3">
          You already have {{ ownedCount === 1 ? 'an app' : `${ownedCount} apps` }} on Free, which covers {{ freeProjects === 1 ? 'one' : freeProjects }}.
          <a href="/pricing" class="text-accent">Pro</a> lifts that, and brings your team with it.
        </div>
      @endif
      {{-- Two buttons under a server @if, not one with a mixed expression.
           The live button's label is a CLIENT expression (it reads the loading
           signal), and a server value like atProjectLimit is not in that scope —
           putting one inside it leaves the raw {{ }} in the HTML for the runtime
           to choke on. Server decides which button exists; the client only ever
           animates the one it owns. --}}
      @if (atProjectLimit)
        <a href="/pricing" class="btn-accent w-full py-2.5 text-sm font-semibold block text-center">Upgrade to add another app</a>
      @endif
      @if (!atProjectLimit)
        <button type="submit" :disabled="loading()" class="btn-accent w-full py-2.5 text-sm font-semibold">
          {{ loading() ? 'Creating…' : 'Create app' }}
        </button>
      @endif
    </form>
    @endif
  </div>
</div>

<!-- Client guard: same pre-paint recovery dashboard, /projects and settings all
     run. Deliberately NOT a client directive — it has to run before paint, and
     it navigates rather than rendering anything.

     Do not write a literal script tag in this comment: the fragment swap
     re-executes scripts by scanning the incoming HTML for them, and it matches
     inside comments, so the words alone produce a SyntaxError mid-navigation. -->
<script>
(function () {
  // Raw document.cookie because this is a bare script that runs before the
  // signals runtime exists, so useStore is not defined yet.
  if (!/(^|;)\s*bughq_token=/.test(document.cookie)) { window.location.replace('/login'); return }
  // The cookie WAS sent and the server still rendered the unauthenticated
  // state, so the token is dead — expired, revoked, or replaced by a newer
  // login. A presence test cannot see that; only the server's verdict can.
  // Leaving now is the whole point: this page's form is the one you lose work
  // in if the bounce waits for submit.
  if (document.getElementById('auth-pending')) {
    document.cookie = 'bughq_token=; path=/; max-age=0'
    window.location.replace('/login')
  }
})()
</script>
