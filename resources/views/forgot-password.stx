<script server>
useHead({ title: 'Reset your password - bughq' })
</script>

<script client>
// Request a password-reset email. The endpoint is anti-enumeration: it always
// answers the same way, so the UI flips to a uniform "sent" state on success.
const error = state('')
const loading = state(false)
const sent = state(false)

async function handleSubmit(e) {
  e.preventDefault()
  if (loading())
    return
  const form = e.target
  loading.set(true)
  error.set('')
  try {
    const res = await fetch('/password/forgot', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: form.elements.email.value }),
    })
    if (!res.ok) {
      const data = await res.json().catch(() => ({}))
      error.set(data.message || 'Something went wrong. Please try again.')
      return
    }
    sent.set(true)
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">

<style>
:root {
  --bg: #fbfbfd; --panel: #ffffff; --border: rgba(15,23,42,0.09);
  --text: #0b0f19; --text-2: #4b5565; --text-3: #97a1b2; --accent: #e11d48;
  --sans: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif; --mono: 'JetBrains Mono', ui-monospace, monospace;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #090b11; --panel: #10131c; --border: rgba(148,163,184,0.12);
    --text: #f3f5f9; --text-2: #b3bccb; --text-3: #667085; --accent: #fb7185; }
}
:root[data-theme="dark"] { --bg: #090b11; --panel: #10131c; --border: rgba(148,163,184,0.12);
  --text: #f3f5f9; --text-2: #b3bccb; --text-3: #667085; --accent: #fb7185; }
:root[data-theme="light"] { --bg: #fbfbfd; --panel: #ffffff; --border: rgba(15,23,42,0.09);
  --text: #0b0f19; --text-2: #4b5565; --text-3: #97a1b2; --accent: #e11d48; }
body { background: var(--bg); color: var(--text); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
.wordmark { font-weight: 700; letter-spacing: -0.03em; }
.field { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; color: var(--text); }
.field:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent); }
.btn { background: var(--accent); color: #fff; border-radius: 10px; transition: transform 0.12s ease, opacity 0.15s ease; }
.btn:hover { background: color-mix(in srgb, var(--accent) 88%, #000); }
.btn:active { transform: translateY(1px); }
.btn:disabled { opacity: 0.6; cursor: default; }
.err { background: color-mix(in srgb, #ef4444 12%, transparent); color: #ef4444; }
.ok { background: color-mix(in srgb, #22c55e 12%, transparent); color: #16a34a; }
</style>

<!-- Applies the saved theme on load. Keep this inline in every app page.

     data-theme lives on the root html element, which the SPA router never
     swaps, so a page reached by a fragment swap inherits it for free. A page
     loaded DIRECTLY only gets it here — so the seven pages that lacked
     it rendered the saved theme when navigated to and the OS default when
     hard-loaded: one URL, two renders depending on how you arrived.

     Not extracted into an @include partial: stx rewrites any page script
     into a scoped client script either way (verified — this is pre-existing
     behaviour, not something the inline form avoids), and the include buys
     no isolation while rendering to nothing in the SSG build path.

     No signal or store either: the theme already lives in two places that
     outlive a swap (the html attribute and localStorage); a store would add
     a third copy of the same fact and fix nothing.

     A missing key means "follow the OS", which the prefers-color-scheme CSS
     already handles, so only an explicit light/dark is applied. try/catch
     because localStorage throws in Safari private mode. -->
<script>(function(){try{var t=localStorage.getItem('bughq_theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t)}catch(e){}})()</script>

<div class="min-h-[100dvh] flex items-center justify-center px-5 py-12">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <a href="/" data-no-router class="wordmark text-2xl">bughq</a>
      <p class="text-sm mt-2 text-subtle">Reset your password</p>
    </div>

    @if (sent())
      <div class="ok text-sm rounded-lg px-3 py-3">
        If an account exists for that email, a reset link is on its way. It expires in 60 minutes.
      </div>
      <p class="text-center text-sm mt-6 text-subtle">
        <StxLink to="/login" class="font-medium text-accent">Back to sign in</StxLink>
      </p>
    @else
      <form @submit="handleSubmit" class="space-y-4">
        @if (error())
          <div class="err text-sm rounded-lg px-3 py-2">{{ error() }}</div>
        @endif

        <p class="text-sm text-muted">Enter the email you signed up with and we will send you a link to reset your password.</p>

        <div>
          <label class="block text-xs font-medium mb-1.5 text-muted">Email</label>
          <input name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="field w-full px-3.5 py-2.5 text-sm">
        </div>

        <button type="submit" :disabled="loading()" class="btn w-full py-2.5 text-sm font-semibold">
          {{ loading() ? 'Sending…' : 'Send reset link' }}
        </button>
      </form>

      <p class="text-center text-sm mt-6 text-subtle">
        Remembered it?
        <StxLink to="/login" class="font-medium text-accent">Sign in</StxLink>
      </p>
    @endif
  </div>
</div>
