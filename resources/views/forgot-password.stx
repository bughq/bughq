<script server>
useHead({ title: 'Reset your password - bughq' })
</script>

<script client>
// Request a password-reset email. The endpoint is anti-enumeration: it always
// answers the same way, so the UI flips to a uniform "sent" state on success.
const error = state('')
const loading = state(false)
const sent = state(false)

// Reading an uncontrolled field is two narrowings: `e.target` is an EventTarget
// and `form.elements` hands back Elements, and neither of those carries a
// `.value`. A field the markup does not contain reads as empty rather than
// throwing — the endpoint validates what it is sent regardless.
function fieldValue(form: HTMLFormElement, name: string): string {
  const el = form.elements.namedItem(name)
  return el instanceof HTMLInputElement ? el.value : ''
}

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target
  if (!(form instanceof HTMLFormElement))
    return
  loading.set(true)
  error.set('')
  try {
    const res = await fetch('/password/forgot', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: fieldValue(form, 'email') }),
    })
    if (!res.ok) {
      const data: { message?: string } = await res.json().catch(() => ({}))
      error.set(data.message || 'Something went wrong. Please try again.')
      return
    }
    sent.set(true)
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>


<style>
.field:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent); }
.err { background: color-mix(in srgb, #ef4444 12%, transparent); color: #ef4444; }
.ok { background: color-mix(in srgb, #22c55e 12%, transparent); color: #16a34a; }
</style>

<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-sm w-full">
    <div class="mb-8 text-center">
      <a href="/" class="text-2xl wordmark">bughq</a>
      <p class="mt-2 text-sm text-subtle">Reset your password</p>
    </div>

    @if (sent())
      <div class="px-3 py-3 text-sm rounded-lg ok">
        If an account exists for that email, a reset link is on its way. It expires in 60 minutes.
      </div>
      <p class="mt-6 text-center text-sm text-subtle">
        <StxLink to="/login" class="font-medium text-accent">Back to sign in</StxLink>
      </p>
    @else
      <form @submit="handleSubmit" class="space-y-4">
        @if (error())
          <div class="px-3 py-2 text-sm rounded-lg err">{{ error() }}</div>
        @endif

        <p class="text-muted text-sm">Enter the email you signed up with and we will send you a link to reset your password.</p>

        <div>
          <label for="forgot-email" class="block mb-1.5 font-medium text-muted text-xs">Email</label>
          <input name="email" id="forgot-email" type="email" required autocomplete="email" placeholder="you@example.com" class="px-3.5 py-2.5 w-full text-sm field">
        </div>

        <button type="submit" :disabled="loading()" class="py-2.5 w-full font-semibold text-sm btn-accent">
          {{ loading() ? 'Sending…' : 'Send reset link' }}
        </button>
      </form>

      <p class="mt-6 text-center text-sm text-subtle">
        Remembered it?
        <StxLink to="/login" class="font-medium text-accent">Sign in</StxLink>
      </p>
    @endif
  </div>
</div>
