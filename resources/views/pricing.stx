<script server>
useSeoMeta({
  title: "Pricing - bughq",
  description: "Simple, honest pricing for bughq error tracking. Free for five projects on your own, Pro for unlimited projects and your team, or self-host free forever.",
  canonical: "https://bughq.org/pricing",
})
</script>

@extends('marketing')

@section('content')
    <main>
      <Breadcrumb className="shell subnav" :items="[{ label: 'Home', href: '/' }, { label: 'Pricing' }]" />

      <script client>
      // Pricing / upgrade via stx client directives. Interval + state are signals; the
      // Upgrade button starts a Stripe Checkout (external redirect via location).
      const interval = state('monthly')
      const err = state('')
      const loading = state(false)

      function pick(v: string): void { interval.set(v) }

      async function upgrade() {
        loading.set(true)
        err.set('')
        try {
          // /payments/checkout runs .middleware('auth'), which authenticates
          // from the HttpOnly `auth-token` cookie sent with credentials — no
          // bearer to read (it is unreadable in JS) and no pre-check. A signed-
          // out visitor gets a 401 here and is sent to /login.
          const res = await fetch('/payments/checkout', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ interval: interval() }),
          })
          if (res.status === 401) { navigate('/login'); return }
          const data = await res.json().catch(() => ({}))
          // An absolute third-party checkout URL. navigate() with reload bypasses
          // the router and performs a real document load, which is the only
          // sensible thing to do with an off-site address.
          if (res.ok && data.url) { navigate(data.url, { reload: true }); return }
          err.set(data.error || 'Checkout is not available yet.')
        }
        catch {
          err.set('Something went wrong. Please try again.')
        }
        finally {
          loading.set(false)
        }
      }
      </script>

      <section class="feat-hero shell">
        <span class="kicker">Pricing</span>
        <h1>Simple, honest pricing</h1>
        <p>Start free. Upgrade when you outgrow it. Self-host free forever.</p>
        <div class="inline-flex gap-1 items-center mt-6 p-1 text-sm border border-line border-solid rounded-pill">
          <button @click="pick('monthly')" :class="interval() === 'monthly' ? 'px-4 py-1.5 font-medium rounded-pill border-none cursor-pointer bg-accent text-accent-ink' : 'px-4 py-1.5 font-medium rounded-pill border-none cursor-pointer bg-transparent text-muted'">Monthly</button>
          <button @click="pick('yearly')" :class="interval() === 'yearly' ? 'px-4 py-1.5 font-medium rounded-pill border-none cursor-pointer bg-accent text-accent-ink' : 'px-4 py-1.5 font-medium rounded-pill border-none cursor-pointer bg-transparent text-muted'">Yearly <span style="opacity:.8">-17%</span></button>
        </div>
      </section>

      <section class="reveal section shell" aria-label="Plans">
        <div class="grid gap-5 md:grid-cols-2">
          <div class="p-7 card-tier">
            <div class="font-semibold text-sm text-subtle tracking-wider uppercase">Free</div>
            <div class="mt-3"><span class="text-4xl wordmark">$0</span><span class="text-sm text-subtle"> / forever</span></div>
            <p class="mt-2 text-muted text-sm">Enough to run a handful of apps properly.</p>
            <ul class="mt-6 space-y-2.5 text-sm">
              <li class="flex gap-2 items-center"><span class="text-accent">✓</span> 5 projects</li>
              <li class="flex gap-2 items-center"><span class="text-accent">✓</span> 5k errors a month</li>
              <li class="flex gap-2 items-center"><span class="text-accent">✓</span> 30 days of history</li>
              <li class="flex gap-2 items-center"><span class="text-accent">✓</span> Just you</li>
              <li class="flex gap-2 items-center"><span class="text-accent">✓</span> Community support</li>
            </ul>
            <StxLink to="/register" class="mt-7 w-full btn ghost">Get started</StxLink>
          </div>

          <div class="p-7 card-tier-pro">
            <div class="font-semibold text-accent text-sm tracking-wider uppercase">Pro</div>
            <div class="mt-3">
              <span class="text-4xl wordmark">{{ interval() === 'yearly' ? '\$190' : '\$19' }}</span><span class="text-sm text-subtle">{{ interval() === 'yearly' ? ' / year' : ' / month' }}</span>
            </div>
            <p class="mt-2 text-muted text-sm">When one app and one person stops being the shape of it.</p>
            <ul class="mt-6 space-y-2.5 text-sm">
              <li class="flex gap-2 items-center"><span class="text-accent">✓</span> Unlimited projects</li>
              <li class="flex gap-2 items-center"><span class="text-accent">✓</span> Unlimited errors</li>
              <li class="flex gap-2 items-center"><span class="text-accent">✓</span> Full history</li>
              <li class="flex gap-2 items-center"><span class="text-accent">✓</span> Invite your team</li>
              <li class="flex gap-2 items-center"><span class="text-accent">✓</span> Priority support</li>
            </ul>
            <button @click="upgrade" :disabled="loading()" class="mt-7 w-full disabled:opacity-60 disabled:cursor-default btn primary">{{ loading() ? 'Redirecting…' : 'Upgrade to Pro' }}</button>
            @if (err())
              <p class="mt-3 text-[#ef4444] text-center text-xs">{{ err() }}</p>
            @endif
          </div>
        </div>
        <p class="mt-10 text-center text-subtle text-xs">Prefer to self-host? bughq is open source and free to run yourself.</p>
      </section>
    </main>
@endsection
