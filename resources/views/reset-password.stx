<script server>
useHead({ title: 'Choose a new password - bughq' })
</script>

<script client>
// Set a new password from an emailed reset link (/reset-password?token=…&email=…).
// The token is single-use and expiring; the server verifies it against a bcrypt
// hash and revokes every session on success.
const error = state('')
const loading = state(false)
const done = state(false)

function linkParams() {
  const q = new URLSearchParams(typeof location !== 'undefined' ? location.search : '')
  return { token: q.get('token') || '', email: q.get('email') || '' }
}

// Reading an uncontrolled field is two narrowings: `e.target` is an EventTarget
// and `form.elements` hands back Elements, and neither of those carries a
// `.value`. A field the markup does not contain reads as empty rather than
// throwing — the endpoint validates what it is sent regardless.
function fieldValue(form: HTMLFormElement, name: string): string {
  const el = form.elements.namedItem(name)
  return el instanceof HTMLInputElement ? el.value : ''
}

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target
  if (!(form instanceof HTMLFormElement))
    return
  const password = fieldValue(form, 'password')
  const confirmation = fieldValue(form, 'password_confirmation')
  if (password !== confirmation) {
    error.set('Passwords do not match.')
    return
  }
  if (password.length < 8) {
    error.set('Password must be at least 8 characters.')
    return
  }
  const { token, email } = linkParams()
  if (!token || !email) {
    error.set('This reset link is invalid. Request a new one below.')
    return
  }
  loading.set(true)
  error.set('')
  try {
    const res = await fetch('/password/reset', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token, email, password, password_confirmation: confirmation }),
    })
    const data: { message?: string } = await res.json().catch(() => ({}))
    if (!res.ok) {
      error.set(data.message || 'This reset link is invalid or has expired. Request a new one below.')
      return
    }
    done.set(true)
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>


<style>
.field:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent); }
.err { background: color-mix(in srgb, #ef4444 12%, transparent); color: #ef4444; }
.ok { background: color-mix(in srgb, #22c55e 12%, transparent); color: #16a34a; }
</style>

<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-sm w-full">
    <div class="mb-8 text-center">
      <a href="/" class="text-2xl wordmark">bughq</a>
      <p class="mt-2 text-sm text-subtle">Choose a new password</p>
    </div>

    @if (done())
      <div class="px-3 py-3 text-sm rounded-lg ok">
        Your password has been reset. You have been signed out everywhere; sign in with the new password.
      </div>
      <p class="mt-6 text-center text-sm text-subtle">
        <StxLink to="/login" class="font-medium text-accent">Go to sign in</StxLink>
      </p>
    @else
      <form @submit="handleSubmit" class="space-y-4">
        @if (error())
          <div class="px-3 py-2 text-sm rounded-lg err">{{ error() }}</div>
        @endif

        <div>
          <label for="reset-password" class="block mb-1.5 font-medium text-muted text-xs">New password</label>
          <input name="password" id="reset-password" type="password" required minlength="8" autocomplete="new-password" placeholder="At least 8 characters" class="px-3.5 py-2.5 w-full text-sm field">
        </div>
        <div>
          <label for="reset-password-confirm" class="block mb-1.5 font-medium text-muted text-xs">Confirm new password</label>
          <input name="password_confirmation" id="reset-password-confirm" type="password" required minlength="8" autocomplete="new-password" placeholder="Repeat the password" class="px-3.5 py-2.5 w-full text-sm field">
        </div>

        <button type="submit" :disabled="loading()" class="py-2.5 w-full font-semibold text-sm btn-accent">
          {{ loading() ? 'Resetting…' : 'Reset password' }}
        </button>
      </form>

      <p class="mt-6 text-center text-sm text-subtle">
        Link expired?
        <StxLink to="/forgot-password" class="font-medium text-accent">Request a new one</StxLink>
      </p>
    @endif
  </div>
</div>
