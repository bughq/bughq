<script server>
useHead({ title: 'Choose a new password - bughq' })
</script>

<script client>
// Set a new password from an emailed reset link (/reset-password?token=…&email=…).
// The token is single-use and expiring; the server verifies it against a bcrypt
// hash and revokes every session on success.
const error = state('')
const loading = state(false)
const done = state(false)

const token = state('')
const email = state('')
// 'checking' until /password/verify-token answers, then 'valid' or 'invalid'.
// The form is withheld until then. Without this the page accepts a password and
// a confirmation against a link that died an hour ago, spends a round trip on
// it, and only then says so - and the message it ends up giving is the one it
// could have given before any of the typing.
const linkState = state('checking')

// Reading an uncontrolled field is two narrowings: `e.target` is an EventTarget
// and `form.elements` hands back Elements, and neither of those carries a
// `.value`. A field the markup does not contain reads as empty rather than
// throwing; the endpoint validates what it is sent regardless.
function fieldValue(form: HTMLFormElement, name: string): string {
  const el = form.elements.namedItem(name)
  return el instanceof HTMLInputElement ? el.value : ''
}

onMount(() => {
  const params = useSearchParams()
  const linkToken = params.get('token') || ''
  const linkEmail = params.get('email') || ''
  token.set(linkToken)
  email.set(linkEmail)

  // A link missing either half can be judged without asking the server.
  if (!linkToken || !linkEmail) {
    linkState.set('invalid')
    return
  }

  fetch('/password/verify-token', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'same-origin',
    body: JSON.stringify({ token: linkToken, email: linkEmail }),
  })
    // Only the action's own verdicts condemn a link: 400 for expired or already
    // used, 422 for malformed. A 5xx is this server failing, and `fetch` does
    // not reject on one, so without the explicit check a proxy that is merely
    // down tells people their link expired and sends them to request another
    // that cannot arrive either. Offering the form instead costs nothing: the
    // reset re-verifies, so nothing is ever trusted on this answer.
    .then((res: Response) => { linkState.set(res.ok || res.status >= 500 ? 'valid' : 'invalid') })
    // Same reasoning for a transport failure, which is not a verdict at all.
    .catch(() => { linkState.set('valid') })
})

async function handleSubmit(e: SubmitEvent): Promise<void> {
  e.preventDefault()
  if (loading())
    return
  const form = e.target
  if (!(form instanceof HTMLFormElement))
    return
  const password = fieldValue(form, 'password')
  const confirmation = fieldValue(form, 'password_confirmation')
  if (password !== confirmation) {
    error.set('Passwords do not match.')
    return
  }
  if (password.length < 8) {
    error.set('Password must be at least 8 characters.')
    return
  }
  if (!token() || !email()) {
    error.set('This reset link is invalid. Request a new one below.')
    return
  }
  loading.set(true)
  error.set('')
  try {
    const res = await fetch('/password/reset', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token: token(), email: email(), password, password_confirmation: confirmation }),
    })
    const data: { message?: string } = await res.json().catch(() => ({}))
    if (!res.ok) {
      // The pre-check passed and the reset still refused, so the token died
      // between the two. Send them back for a fresh one rather than leaving
      // them to retype into a form that cannot succeed.
      linkState.set('invalid')
      error.set(data.message || 'This reset link is invalid or has expired. Request a new one below.')
      return
    }
    done.set(true)
  }
  catch {
    error.set('Something went wrong. Please try again.')
  }
  finally {
    loading.set(false)
  }
}
</script>



<div class="flex items-center justify-center px-5 py-12 min-h-[100dvh]">
  <div class="max-w-sm w-full">
    <div class="mb-8 text-center">
      <StxLink to="/" class="text-2xl wordmark">bughq</StxLink>
      <p class="mt-2 text-sm text-subtle">Choose a new password</p>
    </div>

    {{-- Four independent conditions rather than an else-chain: each one carries
         its whole state, so no two can ever be on at once and the form cannot
         linger under the confirmation. --}}
    @if (done())
      <div class="py-3 notice-box ok">
        Your password has been reset. You have been signed out everywhere; sign in with the new password.
      </div>
      <p class="mt-6 text-center text-sm text-subtle">
        <StxLink to="/login" class="font-medium text-accent">Go to sign in</StxLink>
      </p>
    @endif

    @if (!done() && linkState() === 'checking')
      <p class="text-muted text-sm" role="status">Checking your link.</p>
    @endif

    @if (!done() && linkState() === 'invalid')
      <div class="py-2 err notice-box" role="alert">
        That link has expired. Reset links are good for 60 minutes and can only be used once.
      </div>
      <p class="mt-6 text-center text-sm text-subtle">
        <StxLink to="/forgot-password" class="font-medium text-accent">Request a new link</StxLink>
      </p>
    @endif

    @if (!done() && linkState() === 'valid')
      <form @submit="handleSubmit" class="space-y-4">
        @if (error())
          <div id="form-error" role="alert" class="py-2 err notice-box">{{ error() }}</div>
        @endif

        {{-- Present so a password manager knows which account it is saving
             against. The person cannot edit it; the token is bound to it. --}}
        <input type="hidden" name="email" :value="email()" autocomplete="username">

        <div>
          <label for="reset-password" class="block mb-1.5 font-medium text-muted text-xs">New password</label>
          <input name="password" id="reset-password" type="password" required minlength="8" autocomplete="new-password" placeholder="At least 8 characters" class="px-3.5 py-2.5 w-full text-sm field" :aria-invalid="error() ? 'true' : 'false'" :aria-describedby="error() ? 'form-error' : ''">
        </div>
        <div>
          <label for="reset-password-confirm" class="block mb-1.5 font-medium text-muted text-xs">Confirm new password</label>
          <input name="password_confirmation" id="reset-password-confirm" type="password" required minlength="8" autocomplete="new-password" placeholder="Repeat the password" class="px-3.5 py-2.5 w-full text-sm field" :aria-invalid="error() ? 'true' : 'false'" :aria-describedby="error() ? 'form-error' : ''">
        </div>

        <Button type="submit" :loading="loading()" fullWidth className="btn-accent">
          {{ loading() ? 'Resetting…' : 'Reset password' }}
        </Button>
      </form>

      <p class="mt-6 text-center text-sm text-subtle">
        Link expired?
        <StxLink to="/forgot-password" class="font-medium text-accent">Request a new one</StxLink>
      </p>
    @endif
  </div>
</div>
